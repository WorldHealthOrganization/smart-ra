  "@type": "archimate:Capability",
  "schema:identifier": "id-e65a9beed26451658f096dbb2a19b518",
  "schema:name": "Identity & Authentication",
  "schema:description": "This capability provides the technical means to uniquely identify citizens and verify their identity before allowing access to records. It often links a health-specific ID to a national registry or digital identity provider.\r\n\r\nThe purpose is to ensure that health records are linked to the correct person and that unauthorized access is prevented. This is a critical security layer for protecting patient privacy and ensuring data integrity.\r\n\r\nExample: A biometric-based login service that authenticates a patient before displaying their medical results.",
  "schema:category": "Strategy",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1"
}
