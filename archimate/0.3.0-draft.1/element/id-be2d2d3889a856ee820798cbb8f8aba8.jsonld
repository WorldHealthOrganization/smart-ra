  "@id": "https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/element/id-be2d2d3889a856ee820798cbb8f8aba8",
  "@type": "archimate:Capability",
  "schema:identifier": "id-be2d2d3889a856ee820798cbb8f8aba8",
  "schema:name": "Provider & Facility Verification",
  "schema:description": "This capability involves the management and verification of the credentials, licenses, and operational status of health workers and facilities. It ensures that only legitimate and qualified parties participate in the network.\r\n\r\nThe purpose is to establish trust in the identities of the parties providing and accessing health information. This prevents unauthorized practice and ensures that patient data is only handled by verified professionals.\r\n\r\nExample: An automated check against the national health worker registry before a doctor is allowed to sign a medical report.",
  "schema:category": "Strategy",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1"
}
