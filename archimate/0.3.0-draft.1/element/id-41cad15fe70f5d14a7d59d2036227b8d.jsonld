  "schema:identifier": "id-41cad15fe70f5d14a7d59d2036227b8d",
  "schema:name": "Encryption & Key Management Service",
  "schema:description": "This service manages the cryptographic keys used for data encryption and decryption across the ecosystem. It ensures that the keys are stored securely and only accessible to authorized processes.\r\n\r\nThe purpose is to provide the underlying security mechanism for protecting data privacy. Effective key management is essential for the long-term safety of encrypted health information.\r\n\r\nExample: A service that rotates the database encryption keys every 90 days to maintain high security standards.",
  "schema:category": "Application",
  "dcterms:isPartOf": "https://worldhealthorganization.github.io/smart-ra/archimate/0.3.0-draft.1"
}
