  "@type": "archimate:Capability",
  "schema:identifier": "id-bfcf9da50f3e5ce8a22d73c70f736faf",
  "schema:name": "Interoperability & Health Information Exchange",
  "schema:description": "This capability provides the technical infrastructure and standards required for different health IT systems to talk to each other and share data. It involves the use of common APIs, messaging standards, and exchange protocols.\r\n\r\nThe purpose is to enable a unified patient view by connecting fragmented health data sources across the entire health system. This is the primary driver for clinical coordination and longitudinal record creation.\r\nExample: A national HIE hub that routes clinical \r\nsummaries between public clinics and private specialist centers.",
  "schema:category": "Strategy",
  "dcterms:isPartOf": "https://worldhealthorganization.github.io/smart-ra/archimate/0.3.0-draft.1"
}
