    <element xsi:type="archimate:Grouping" name="Q&amp;CC Sub-Goal #7 Application Services" id="id-fa9e126b96c2436c8ece4797e22b9d4f"/>
    <element xsi:type="archimate:Grouping" name="Q&amp;CC Metadata Components" id="id-ca105179422645c683668ea0e66147c6"/>
    <element xsi:type="archimate:Grouping" name="Grouping" id="id-45896cade9eb435d8ca489b38a44101b"/>
    <element xsi:type="archimate:Grouping" name="Grouping" id="id-eef4b21c7783498fb3f2c33b452cacd8"/>
    <element xsi:type="archimate:Grouping" name="Grouping" id="id-a53e959bcca941cc9a9e32882009ccbf"/>
    <element xsi:type="archimate:Grouping" name="Grouping" id="id-4808f8d23cd24bafbb635d00ccde5b9d"/>
    <element xsi:type="archimate:Grouping" name="PMF Sub-Goal #1 Outcomes" id="id-4f312e0a0f054e3b8078411e8eac3089"/>
    <element xsi:type="archimate:Grouping" name="Application Services" id="id-759ba58359254f8493c688555ad1c098"/>
    <element xsi:type="archimate:Grouping" name="PMF Sub-goal #2 Outcomes" id="id-f60e276e5a2f435a91fc8fe578715cb6"/>
    <element xsi:type="archimate:Grouping" name="Application Services" id="id-f244ca0d8ea44c699b51422632370f5d"/>
