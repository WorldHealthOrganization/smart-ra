    <element xsi:type="archimate:Stakeholder" name="Health Program Managers" id="id-f47ce449e7bc49dd96a40bdcfe918c64"/>
    <element xsi:type="archimate:Stakeholder" name="Healthcare Providers" id="id-3afbaa5d39164c9e8b7d3b3adf66af67"/>
    <element xsi:type="archimate:Value" name="Accurate and transparent budgeting" id="id-4c2abc1bb8654d6993daa0e3c0c62d8a"/>
    <element xsi:type="archimate:Value" name="Control over expenditure" id="id-b47d21a4df1e4481a11b53589b1d63eb"/>
