    <element xsi:type="archimate:Value" name="Assurance of payment; continuous service delivery" id="id-04ed66e55d4a43cf9a4ebe355072c3e7"/>
    <element xsi:type="archimate:Goal" name="Ensure efficient, transparent health budgets with timely provider payments." id="id-49e3de8882894bbe9008e14c5d57c500"/>
    <element xsi:type="archimate:Goal" name="Secure sustainable, equitable health sector funds (e.g., taxes, insurance contributions)." id="id-2657add8ce4548b3bf26c3f4354212f6"/>
    <element xsi:type="archimate:Stakeholder" name="Finance Ministry" id="id-d824b978f7984d2b9acd36a961214f67"/>
    <element xsi:type="archimate:Stakeholder" name="Tax Authorities" id="id-98d8526af984496f96cdbe59c7f6498c"/>
    <element xsi:type="archimate:Stakeholder" name="Social Health Insurance Agencies" id="id-413224f89d16401b8408f5cf4a2428ee"/>
    <element xsi:type="archimate:Stakeholder" name="Policy Makers" id="id-af0933b2a47248e9927f6009bf504adf"/>
    <element xsi:type="archimate:Value" name="Stable revenue streams" id="id-242c8fa80f4247ad92b0c61581a634fe"/>
    <element xsi:type="archimate:Value" name="Compliance monitoring" id="id-8fb6d3c8003a45a988bddf27ff33bbf9"/>
    <element xsi:type="archimate:Value" name="Equitable contribution system" id="id-793ef3da2a904af5b826287be5ff4921"/>
    <element xsi:type="archimate:Value" name="Policy enforcement" id="id-eb20cea13ea044699da09f954952e684"/>
    <element xsi:type="archimate:Outcome" name="Predictable health funding" id="id-f2e60c5f82b24ac3ab0e91b16ab35f6e"/>
    <element xsi:type="archimate:Outcome" name="Higher collection efficiency" id="id-a62c93e36e794c8cb1ea6abb4bd51f1d"/>
