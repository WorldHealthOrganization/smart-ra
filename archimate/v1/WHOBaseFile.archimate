      <documentation>Clinical Decision Support Engine (integrated with national guideline repository)</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Notification &amp; Task Manager" id="id-267e653313854e17aa910eef017d8446">
      <documentation>Notification &amp; Task Manager (alerts, reminders, escalation for missed actions)</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Health MGMT Information Service System" id="id-10605ac9d5ed46a8a8cf211d39089011">
      <documentation>Health MGMT Information Service &#xD;
for providers and policymakers&#xD;
tracks KPIs on transition safety and effectiveness&#xD;
continuity KPIs, longitudinal outcomes, population stratification)</documentation>
