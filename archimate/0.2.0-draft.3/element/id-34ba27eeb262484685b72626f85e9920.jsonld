  "schema:identifier": "id-34ba27eeb262484685b72626f85e9920",
  "schema:name": "Facility Registry ",
  "schema:description": "A facility registry maintains standardized information about healthcare facilities, service locations, and operational characteristics. It supports accurate identification and classification of healthcare institutions.\r\n\r\nThe purpose of this data object is to improve coordination, referrals, and reporting across the healthcare system. It also supports interoperability and healthcare network management.\r\n\r\nExample: A referral platform identifies the nearest accredited dialysis center using facility registry information.",
  "schema:category": "Application",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3"
}
