    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/solution-architecture",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Solution Architecture",
          "@language": "en"
        },
        {
          "@value": "بنية الحلول",
          "@language": "ar"
        },
        {
          "@value": "Arquitectura de soluciones",
          "@language": "es"
        },
        {
          "@value": "Architecture de solution",
          "@language": "fr"
        },
        {
          "@value": "Архитектура решения",
          "@language": "ru"
        },
        {
          "@value": "解决方案架构",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "The design of a specific application component or HDPI expressed through specifications and diagrams",
          "@language": "en"
        },
        {
          "@value": "تصميم مكوّن تطبيقي محدد أو HDPI معبَّرًا عنه من خلال المواصفات والمخططات",
          "@language": "ar"
        },
        {
          "@value": "Diseño de un componente de aplicación específico o de una HDPI expresado mediante especificaciones y diagramas",
          "@language": "es"
        },
        {
          "@value": "Conception d'un composant applicatif ou d'une HDPI spécifique, exprimée au moyen de spécifications et de diagrammes",
          "@language": "fr"
        },
        {
          "@value": "Проектирование конкретного компонента приложения или HDPI, выраженное в спецификациях и диаграммах",
          "@language": "ru"
        },
        {
          "@value": "通过规范和图表表达的特定应用组件或HDPI的设计",
          "@language": "zh"
        }
      ],
