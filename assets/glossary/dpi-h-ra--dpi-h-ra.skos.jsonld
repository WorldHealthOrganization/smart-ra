    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/functional-application",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Functional Application",
          "@language": "en"
        },
        {
          "@value": "التطبيق الوظيفي",
          "@language": "ar"
        },
        {
          "@value": "Aplicación funcional",
          "@language": "es"
        },
        {
          "@value": "Application fonctionnelle",
          "@language": "fr"
        },
        {
          "@value": "Функциональное приложение",
          "@language": "ru"
        },
        {
          "@value": "功能性应用",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "Functional application",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Functional applications are application components that deliver a specific operational function within a defined domain. They are context-specific, reflecting the operational requirements of a programme, scheme, or institution that procures them.",
          "@language": "en"
        },
        {
          "@value": "التطبيقات الوظيفية هي مكونات تطبيقية تؤدي وظيفة تشغيلية محددة ضمن مجال محدد. وهي خاصة بالسياق، وتعكس المتطلبات التشغيلية للبرنامج أو المخطط أو المؤسسة التي تشتريها.",
          "@language": "ar"
        },
        {
          "@value": "Las aplicaciones funcionales son componentes de aplicación que cumplen una función operativa específica dentro de un dominio definido. Son específicas del contexto y reflejan los requisitos operativos del programa, régimen o institución que las adquiere.",
          "@language": "es"
        },
        {
          "@value": "Les applications fonctionnelles sont des composants applicatifs qui assurent une fonction opérationnelle spécifique dans un domaine défini. Elles sont propres à un contexte et reflètent les exigences opérationnelles d'un programme, d'un régime ou d'une institution qui en fait l'acquisition.",
          "@language": "fr"
        },
        {
          "@value": "Функциональные приложения — это компоненты приложений, которые выполняют конкретную операционную функцию в пределах определенной области. Они зависят от контекста и отражают операционные требования программы, схемы или учреждения, которые их закупают.",
          "@language": "ru"
        },
        {
          "@value": "功能性应用是在特定领域内提供特定业务职能的应用组件。它们因情境而异，反映采购它们的规划、计划或机构的业务需求。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/functional-application#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/functional-application#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/functional-application#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/functional-application#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/functional-application#label-zh"
        }
      ],
      "skos:scopeNote": "The RA draft's own wording, verbatim. A candidate until the RA editors adopt it through the public review.",
      "dcterms:source": "folio/dpi-h-ra/glossary/t-glossary-lead-a31853.md",
      "skos:note": "candidate"
    },
