    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/user-acceptance-testing",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "User Acceptance Testing",
          "@language": "en"
        },
        {
          "@value": "اختبار قبول المستخدم",
          "@language": "ar"
        },
        {
          "@value": "Pruebas de aceptación del usuario",
          "@language": "es"
        },
        {
          "@value": "Tests d'acceptation par les utilisateurs",
          "@language": "fr"
        },
        {
          "@value": "Приемочное тестирование пользователями",
          "@language": "ru"
        },
        {
          "@value": "用户验收测试",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "UAT",
          "@language": "en"
        },
        {
          "@value": "User acceptance testing",
          "@language": "en"
        },
        {
          "@value": "User acceptance testing (UAT)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "User acceptance testing (UAT) is conducted to see whether the end-users are satisfied with the end product (24).",
          "@language": "en"
        },
        {
          "@value": "يُجرى اختبار قبول المستخدم (UAT) لمعرفة ما إذا كان المستخدمون النهائيون راضين عن المنتج النهائي (24).",
          "@language": "ar"
        },
        {
          "@value": "Las pruebas de aceptación del usuario (UAT) se realizan para comprobar si los usuarios finales están satisfechos con el producto final (24).",
          "@language": "es"
        },
        {
          "@value": "Les tests d'acceptation par les utilisateurs (UAT) sont réalisés pour déterminer si les utilisateurs finaux sont satisfaits du produit final (24).",
          "@language": "fr"
        },
        {
          "@value": "Приемочное тестирование пользователями (UAT) проводится для того, чтобы определить, удовлетворены ли конечные пользователи конечным продуктом (24).",
          "@language": "ru"
        },
        {
          "@value": "开展用户验收测试（UAT）是为了了解最终用户是否对最终产品感到满意 (24)。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/user-acceptance-testing#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/user-acceptance-testing#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/user-acceptance-testing#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/user-acceptance-testing#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/user-acceptance-testing#label-zh"
        }
      ],
      "skos:notation": "UAT",
      "skos:scopeNote": "PHC handbook glossary wording, verbatim (who-iris/library/9789240093362-eng/sections/sec-002-glossary.md, p. 11). Wording alternatives across the DTH corpus (smart-ra#133 S1): (1) PC handbook glossary ('User acceptance testing (UAT)', who-iris/library/9789240116191-eng/sections/page-009.md, p. 9): \"UAT is done to see whether the end-users are satisfied with the end product.14\" (2) SFP handbook glossary ('User acceptance testing (UAT)', who-iris/library/9789240120747-eng/sections/page-011.md, p. 11): \"User acceptance testing is done to see whether the end users are satisfied with the end product (20).\" All three are recorded as candidates; none is chosen.",
      "dcterms:source": "who-iris/library/9789240093362-eng/sections/sec-002-glossary.md",
      "skos:note": "candidate"
    },
