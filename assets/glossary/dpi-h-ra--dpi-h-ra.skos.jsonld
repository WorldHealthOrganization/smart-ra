    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/digitization",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Digitization",
          "@language": "en"
        },
        {
          "@value": "التحويل إلى الصيغة الرقمية",
          "@language": "ar"
        },
        {
          "@value": "Digitización",
          "@language": "es"
        },
        {
          "@value": "Numérisation",
          "@language": "fr"
        },
        {
          "@value": "Оцифровка",
          "@language": "ru"
        },
        {
          "@value": "数字转换",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "digitization",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The process of converting and organizing data from paper records into a digital format for easier entry, storage and retrieval (12,16).",
          "@language": "en"
        },
        {
          "@value": "عملية تحويل البيانات من السجلات الورقية وتنظيمها في صيغة رقمية لتسهيل إدخالها وتخزينها واسترجاعها (12,16).",
          "@language": "ar"
        },
        {
          "@value": "Proceso de convertir y organizar los datos de registros en papel a un formato digital para facilitar su introducción, almacenamiento y recuperación (12,16).",
          "@language": "es"
        },
        {
          "@value": "Processus consistant à convertir et organiser les données des dossiers papier dans un format numérique afin d'en faciliter la saisie, le stockage et la consultation (12,16).",
          "@language": "fr"
        },
        {
          "@value": "Процесс преобразования и упорядочения данных из бумажных записей в цифровой формат для упрощения ввода, хранения и поиска (12,16).",
          "@language": "ru"
        },
        {
          "@value": "将纸质记录中的数据转换并组织为数字格式，以便于录入、存储和检索的过程 (12,16)。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/digitization#label-ar"
