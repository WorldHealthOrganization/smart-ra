    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/reference-architecture",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Reference Architecture",
          "@language": "en"
        },
        {
          "@value": "البنية المرجعية",
          "@language": "ar"
        },
        {
          "@value": "Arquitectura de referencia",
          "@language": "es"
        },
        {
          "@value": "Architecture de référence",
          "@language": "fr"
        },
        {
          "@value": "Эталонная архитектура",
          "@language": "ru"
        },
        {
          "@value": "参考架构",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "RA",
          "@language": "en"
        },
        {
          "@value": "reference architecture",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A technology-neutral blueprint that captures the common building blocks, relationships, and design principles of a technical environment.",
          "@language": "en"
        },
        {
          "@value": "مخطط أساسي محايد تكنولوجيًا يجسّد اللبنات الأساسية المشتركة والعلاقات ومبادئ التصميم لبيئة تقنية.",
          "@language": "ar"
        },
        {
          "@value": "Plano de diseño, neutral desde el punto de vista tecnológico, que recoge los componentes básicos comunes, las relaciones y los principios de diseño de un entorno técnico.",
          "@language": "es"
        },
        {
          "@value": "Plan directeur neutre sur le plan technologique qui rend compte des éléments constitutifs communs, des relations et des principes de conception d'un environnement technique.",
          "@language": "fr"
        },
        {
          "@value": "Технологически нейтральный типовой план, отражающий общие строительные блоки, взаимосвязи и принципы проектирования технической среды.",
          "@language": "ru"
        },
        {
          "@value": "一种技术中立的蓝图，涵盖技术环境的通用构建模块、关系和设计原则。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/reference-architecture#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/reference-architecture#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/reference-architecture#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/reference-architecture#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/reference-architecture#label-zh"
        }
      ],
      "skos:notation": "RA",
      "skos:scopeNote": "The RA draft's own glossary wording, verbatim (folio/dpi-h-ra/glossary/t-glossary-lead-a31853.md). Wording alternative in RA §1.1.1 body (library/who-dpi-h-reference-architecture-draft-v1/sections/sec-001-111-what-is-a-reference-architecture-and-why-doe.md): \"A reference architecture is a technology-neutral blueprint that captures the common building blocks, relationships, and design principles of a technical environment, so that organisations do not have to start from a blank page.\" Both are recorded as candidates; neither is chosen (smart-ra#133 S1).",
      "dcterms:source": "folio/dpi-h-ra/glossary/t-glossary-lead-a31853.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/reference-architecture#label-ar",
      "@type": "skosxl:Label",
      "skosxl:literalForm": {
        "@value": "البنية المرجعية",
        "@language": "ar"
      },
