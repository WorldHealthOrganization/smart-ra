        },
        {
          "@value": "Logical Observation Identifiers Names and Codes",
          "@language": "ru"
        },
        {
          "@value": "Logical Observation Identifiers Names and Codes",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "LOINC",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "LOINC is a common language (a set of identifiers, names, and codes) for identifying health measurements, observations, and documents.",
          "@language": "en"
        },
        {
          "@value": "LOINC لغة مشتركة (مجموعة من المعرّفات والأسماء والرموز) لتحديد القياسات والملاحظات والوثائق الصحية.",
          "@language": "ar"
        },
        {
          "@value": "LOINC es un lenguaje común (un conjunto de identificadores, nombres y códigos) para identificar mediciones, observaciones y documentos de salud.",
          "@language": "es"
        },
        {
          "@value": "LOINC est un langage commun (un ensemble d'identifiants, de noms et de codes) permettant d'identifier les mesures, observations et documents de santé.",
          "@language": "fr"
        },
        {
          "@value": "LOINC — это общий язык (набор идентификаторов, наименований и кодов) для идентификации медицинских измерений, наблюдений и документов.",
          "@language": "ru"
        },
        {
          "@value": "LOINC是用于标识卫生测量、观察和文档的通用语言（一组标识符、名称和代码）。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/logical-observation-identifiers-names-and-codes#label-ar"
