        {
          "@value": "end user",
          "@language": "en"
        },
        {
          "@value": "end users",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "People who will be using the digital system(s).",
          "@language": "en"
        },
        {
          "@value": "الأشخاص الذين سيستخدمون النظام أو النظم الرقمية.",
          "@language": "ar"
        },
        {
          "@value": "Personas que utilizarán el sistema o sistemas digitales.",
          "@language": "es"
        },
        {
          "@value": "Personnes qui utiliseront le ou les systèmes numériques.",
          "@language": "fr"
        },
        {
          "@value": "Люди, которые будут пользоваться цифровой системой (системами).",
          "@language": "ru"
        },
        {
          "@value": "将使用数字系统的人员。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
