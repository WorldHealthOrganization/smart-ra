    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/logical-information-model-repository",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Logical Information Model Repository",
          "@language": "en"
        },
        {
          "@value": "مستودع نماذج المعلومات المنطقية",
          "@language": "ar"
        },
        {
          "@value": "Repositorio de modelos lógicos de información",
          "@language": "es"
        },
        {
          "@value": "Référentiel des modèles d'information logiques",
          "@language": "fr"
        },
        {
          "@value": "Репозиторий логических информационных моделей",
          "@language": "ru"
        },
        {
          "@value": "逻辑信息模型存储库",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "LIMR",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The Logical Information Model Repository is a governed, publicly accessible repository and management platform for computable clinical and administrative information models that define the logical structure, semantics, and terminology bindings of health data objects across a national digital health ecosystem.",
          "@language": "en"
        },
        {
          "@value": "مستودع نماذج المعلومات المنطقية مستودع ومنصة إدارة خاضعان للحوكمة ومتاحان للعموم لنماذج المعلومات السريرية والإدارية القابلة للحوسبة التي تحدد البنية المنطقية والدلالات وروابط المصطلحات لكائنات البيانات الصحية عبر منظومة وطنية للصحة الرقمية.",
          "@language": "ar"
        },
        {
          "@value": "El Repositorio de modelos lógicos de información es un repositorio y plataforma de gestión gobernado y de acceso público para modelos de información clínica y administrativa computables que definen la estructura lógica, la semántica y los vínculos terminológicos de los objetos de datos de salud en un ecosistema nacional de salud digital.",
          "@language": "es"
        },
        {
          "@value": "Le référentiel des modèles d'information logiques est un référentiel et une plateforme de gestion gouvernés et accessibles au public pour les modèles d'information cliniques et administratifs computables qui définissent la structure logique, la sémantique et les liaisons terminologiques des objets de données de santé dans un écosystème national de santé numérique.",
          "@language": "fr"
        },
        {
          "@value": "Репозиторий логических информационных моделей — это управляемый общедоступный репозиторий и платформа управления для вычислимых клинических и административных информационных моделей, которые определяют логическую структуру, семантику и терминологические привязки объектов медицинских данных в национальной экосистеме цифрового здравоохранения.",
          "@language": "ru"
        },
        {
          "@value": "逻辑信息模型存储库是一个受治理、可公开访问的存储库和管理平台，用于管理可计算的临床和行政信息模型，这些模型定义了国家数字卫生生态系统中卫生数据对象的逻辑结构、语义和术语绑定。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/logical-information-model-repository#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/logical-information-model-repository#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/logical-information-model-repository#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/logical-information-model-repository#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/logical-information-model-repository#label-zh"
        }
      ],
      "skos:notation": "LIMR",
      "skos:scopeNote": "Verbatim lead sentence from Appendix C (Logical Information Model Repository, 1 What It Is). Abbreviated LIMR throughout the RA draft. A candidate until the RA editors adopt it through the public review.",
      "dcterms:source": "folio/dpi-h-ra/appendix/p-c-metadata-registries-and-foundati-logical-information-model-reposi-73f642.md",
      "skos:note": "candidate"
