      "skos:definition": [
        {
          "@value": "The Open Group Architecture Framework, an enterprise architecture framework and method, published by The Open Group, for developing an enterprise architecture.",
          "@language": "en"
        },
        {
          "@value": "The Open Group Architecture Framework، وهو إطار ومنهجية لبنية المؤسسة، تنشره The Open Group، لتطوير بنية المؤسسة.",
          "@language": "ar"
        },
        {
          "@value": "The Open Group Architecture Framework, un marco y método de arquitectura empresarial, publicado por The Open Group, para desarrollar una arquitectura empresarial.",
          "@language": "es"
        },
        {
          "@value": "The Open Group Architecture Framework, cadre et méthode d'architecture d'entreprise, publié par The Open Group, pour l'élaboration d'une architecture d'entreprise.",
          "@language": "fr"
        },
        {
          "@value": "The Open Group Architecture Framework — рамочная основа и метод архитектуры предприятия, публикуемые консорциумом The Open Group, для разработки архитектуры предприятия.",
          "@language": "ru"
        },
        {
          "@value": "The Open Group Architecture Framework，一种由The Open Group发布、用于开发企业架构的企业架构框架和方法。",
          "@language": "zh"
        }
      ],
