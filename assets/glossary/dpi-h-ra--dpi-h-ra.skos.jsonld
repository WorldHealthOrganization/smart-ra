    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/point-of-service-applications",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Point-of-Service Applications",
          "@language": "en"
        },
        {
          "@value": "تطبيقات نقاط تقديم الخدمة",
          "@language": "ar"
        },
        {
          "@value": "Aplicaciones en el punto de servicio",
          "@language": "es"
        },
        {
          "@value": "Applications au point de service",
          "@language": "fr"
        },
        {
          "@value": "Приложения в месте оказания услуг",
          "@language": "ru"
        },
        {
          "@value": "服务点应用",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "POS",
          "@language": "en"
        },
        {
          "@value": "Point-of-service applications",
          "@language": "en"
        },
        {
          "@value": "Point of Service Application",
          "@language": "en"
        },
        {
          "@value": "PoS",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Point-of-service applications are end-user application components (IT systems or software tools) used by individuals directly engaged in healthcare—such as clinicians, community health workers, and patients—that enable interaction with the broader healthcare ecosystem.",
          "@language": "en"
        },
        {
          "@value": "تطبيقات نقاط تقديم الخدمة هي مكونات تطبيقية للمستخدم النهائي (نظم تكنولوجيا المعلومات أو أدوات برمجية) يستخدمها الأفراد المنخرطون مباشرةً في الرعاية الصحية — مثل الأطباء السريريين والعاملين الصحيين المجتمعيين والمرضى — وتتيح التفاعل مع منظومة الرعاية الصحية الأوسع.",
          "@language": "ar"
        },
        {
          "@value": "Las aplicaciones en el punto de servicio son componentes de aplicación para usuarios finales (sistemas de TI o herramientas de software) utilizados por personas que participan directamente en la atención de salud —como médicos y otros profesionales clínicos, agentes de salud comunitarios y pacientes— y que permiten interactuar con el ecosistema de atención de salud en sentido amplio.",
          "@language": "es"
        },
        {
          "@value": "Les applications au point de service sont des composants applicatifs destinés aux utilisateurs finaux (systèmes informatiques ou outils logiciels), utilisés par des personnes directement engagées dans les soins de santé — telles que les cliniciens, les agents de santé communautaires et les patients — qui permettent l'interaction avec l'écosystème de santé au sens large.",
          "@language": "fr"
        },
        {
          "@value": "Приложения в месте оказания услуг — это компоненты приложений для конечных пользователей (IT-системы или программные инструменты), используемые лицами, непосредственно участвующими в оказании медицинской помощи, — такими как клиницисты, общинные медицинские работники и пациенты, — которые обеспечивают взаимодействие с более широкой экосистемой здравоохранения.",
          "@language": "ru"
        },
        {
          "@value": "服务点应用是由直接参与卫生保健的个人（如临床医生、社区卫生工作者和患者）使用的最终用户应用组件（IT系统或软件工具），使其能够与更广泛的卫生保健生态系统进行交互。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/point-of-service-applications#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/point-of-service-applications#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/point-of-service-applications#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/point-of-service-applications#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/point-of-service-applications#label-zh"
        }
      ],
      "skos:notation": "POS",
      "skos:scopeNote": "The RA draft's own wording, verbatim. A candidate until the RA editors adopt it through the public review. The draft marks this entry [Under review]. Also categorized in SFP handbook §3.2 Fig. 3 (who-iris/library/9789240120747-eng/sections/sec-020-32-link-to-the-enterprise-architecture.md, page-034.md, p. 22, citing DIIG) into reused POS applications and unique POS applications.",
      "skos:editorialNote": "Under review",
      "dcterms:source": "folio/dpi-h-ra/glossary/t-glossary-lead-a31853.md",
      "skos:note": "candidate"
    },
