      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/goal#label-ar",
      "@type": "skosxl:Label",
      "skosxl:literalForm": {
        "@value": "الهدف",
        "@language": "ar"
      },
      "fa:translationStatus": "unofficial"
    },
