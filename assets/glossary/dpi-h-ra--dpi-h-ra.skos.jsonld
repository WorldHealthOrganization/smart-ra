    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/integration",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Integration",
          "@language": "en"
        },
        {
          "@value": "التكامل",
          "@language": "ar"
        },
        {
          "@value": "Integración",
          "@language": "es"
        },
        {
          "@value": "Intégration",
          "@language": "fr"
        },
        {
          "@value": "Интеграция",
          "@language": "ru"
        },
        {
          "@value": "集成",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "Bespoke capability of connecting one application component to another",
          "@language": "en"
        },
        {
          "@value": "قدرة مُصمَّمة حسب الطلب على ربط مكوّن تطبيقي بآخر",
          "@language": "ar"
        },
        {
          "@value": "Capacidad a medida de conectar un componente de aplicación con otro",
          "@language": "es"
        },
        {
          "@value": "Capacité sur mesure de connecter un composant applicatif à un autre",
          "@language": "fr"
        },
        {
          "@value": "Индивидуально разработанная возможность подключения одного компонента приложения к другому",
          "@language": "ru"
        },
        {
          "@value": "将一个应用组件连接到另一个应用组件的定制能力",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/integration#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/integration#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/integration#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/integration#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/integration#label-zh"
        }
      ],
      "skos:scopeNote": "The RA draft's own wording, verbatim. A candidate until the RA editors adopt it through the public review. The draft marks this entry [Under review].",
      "skos:editorialNote": "Under review",
      "dcterms:source": "folio/dpi-h-ra/glossary/t-glossary-lead-a31853.md",
      "skos:note": "candidate"
    },
