    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-programme",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Health Programme",
          "@language": "en"
        },
        {
          "@value": "البرنامج الصحي",
          "@language": "ar"
        },
        {
          "@value": "Programa de salud",
          "@language": "es"
        },
        {
          "@value": "Programme de santé",
          "@language": "fr"
        },
        {
          "@value": "Программа здравоохранения",
          "@language": "ru"
        },
        {
          "@value": "卫生规划",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "Health programmes are structured and coordinated interventions and services, delivered to defined populations or patient groups, to prevent disease, promote health, and address specific health needs.",
          "@language": "en"
        },
        {
          "@value": "البرامج الصحية هي تدخلات وخدمات منظمة ومنسقة، تُقدَّم لفئات سكانية أو مجموعات مرضى محددة، للوقاية من الأمراض وتعزيز الصحة وتلبية احتياجات صحية محددة.",
          "@language": "ar"
        },
        {
          "@value": "Los programas de salud son intervenciones y servicios estructurados y coordinados, dirigidos a poblaciones o grupos de pacientes definidos, para prevenir enfermedades, promover la salud y atender necesidades de salud específicas.",
          "@language": "es"
        },
        {
          "@value": "Les programmes de santé sont des interventions et services structurés et coordonnés, fournis à des populations ou groupes de patients définis, pour prévenir les maladies, promouvoir la santé et répondre à des besoins de santé spécifiques.",
          "@language": "fr"
        },
        {
          "@value": "Программы здравоохранения — это структурированные и скоординированные вмешательства и услуги, предоставляемые определенным группам населения или группам пациентов в целях профилактики заболеваний, укрепления здоровья и удовлетворения конкретных потребностей в области здоровья.",
          "@language": "ru"
        },
        {
          "@value": "卫生规划是向特定人群或患者群体提供的结构化、协调一致的干预措施和服务，旨在预防疾病、促进健康和满足特定卫生需求。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-programme#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-programme#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-programme#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-programme#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-programme#label-zh"
        }
      ],
      "skos:scopeNote": "The RA draft's own wording, verbatim. A candidate until the RA editors adopt it through the public review.",
      "dcterms:source": "folio/dpi-h-ra/glossary/t-glossary-lead-a31853.md",
