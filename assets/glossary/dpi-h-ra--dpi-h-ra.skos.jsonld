    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/organogram",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Organogram",
          "@language": "en"
        },
        {
          "@value": "الهيكل التنظيمي",
          "@language": "ar"
        },
        {
          "@value": "Organigrama",
          "@language": "es"
        },
        {
          "@value": "Organigramme",
          "@language": "fr"
        },
        {
          "@value": "Органограмма",
          "@language": "ru"
        },
        {
          "@value": "组织结构图",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "organogram",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A visual representation of an organization’s structure that shows the hierarchy of various roles and reporting relationships.",
          "@language": "en"
        },
        {
          "@value": "تمثيل مرئي لهيكل المؤسسة يبيّن التسلسل الهرمي لمختلف الأدوار وعلاقات التبعية الإدارية.",
          "@language": "ar"
        },
        {
          "@value": "Representación visual de la estructura de una organización que muestra la jerarquía de las distintas funciones y las relaciones de dependencia jerárquica.",
          "@language": "es"
        },
        {
          "@value": "Représentation visuelle de la structure d'une organisation qui montre la hiérarchie des différents rôles et les liens hiérarchiques.",
          "@language": "fr"
        },
        {
          "@value": "Визуальное представление структуры организации, показывающее иерархию различных ролей и отношения подотчетности.",
          "@language": "ru"
        },
        {
          "@value": "组织结构的可视化表示，显示各种角色的层级和汇报关系。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/organogram#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/organogram#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/organogram#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/organogram#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/organogram#label-zh"
        }
      ],
      "skos:scopeNote": "SC handbook glossary wording, verbatim (who-iris/library/9789240101197-eng/sections/page-009.md, p. 9). Wording alternative in PC handbook glossary (who-iris/library/9789240116191-eng/sections/page-008.md, p. 8) and SFP handbook glossary (who-iris/library/9789240120747-eng/sections/sec-002-glossary.md, page-010.md, p. 10): \"A visual representation of the organization structure showing the hierarchy of various roles and their reporting relationships.\" Both are recorded as candidates; neither is chosen (smart-ra#133 S1).",
      "dcterms:source": "who-iris/library/9789240101197-eng/sections/page-009.md",
      "skos:note": "candidate"
    },
