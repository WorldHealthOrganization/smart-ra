    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/total-cost-of-ownership",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Total Cost of Ownership",
          "@language": "en"
        },
        {
          "@value": "التكلفة الإجمالية للملكية",
          "@language": "ar"
        },
        {
          "@value": "Costo total de propiedad",
          "@language": "es"
        },
        {
          "@value": "Coût total de possession",
          "@language": "fr"
        },
        {
          "@value": "Совокупная стоимость владения",
          "@language": "ru"
        },
        {
          "@value": "总拥有成本",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "TCO",
          "@language": "en"
        },
        {
          "@value": "total cost of ownership",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The resources required to support a digital health intervention throughout its life cycle.",
          "@language": "en"
        },
        {
          "@value": "الموارد اللازمة لدعم تدخل صحي رقمي طوال دورة حياته.",
          "@language": "ar"
        },
        {
          "@value": "Recursos necesarios para sostener una intervención de salud digital a lo largo de su ciclo de vida.",
          "@language": "es"
        },
        {
          "@value": "Ressources nécessaires pour soutenir une intervention de santé numérique tout au long de son cycle de vie.",
          "@language": "fr"
        },
        {
          "@value": "Ресурсы, необходимые для поддержки цифрового вмешательства в области здравоохранения на протяжении всего его жизненного цикла.",
          "@language": "ru"
        },
        {
          "@value": "在数字卫生干预措施整个生命周期内为其提供支持所需的资源。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/total-cost-of-ownership#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/total-cost-of-ownership#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/total-cost-of-ownership#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/total-cost-of-ownership#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/total-cost-of-ownership#label-zh"
        }
      ],
      "skos:notation": "TCO",
      "skos:scopeNote": "SC handbook glossary wording, verbatim (who-iris/library/9789240101197-eng/sections/page-009.md, p. 9). Shared concept across SC (Ch. 3 Fig. 23, p. 49) and SFP (p. 49); recorded as a candidate.",
      "dcterms:source": "who-iris/library/9789240101197-eng/sections/page-009.md",
      "skos:note": "candidate"
    },
