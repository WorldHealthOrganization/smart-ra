      "fa:translationStatus": "unofficial"
    },
    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/public-health-surveillance-platform",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Public Health Surveillance Platform",
          "@language": "en"
        },
        {
          "@value": "منصة ترصد الصحة العامة",
          "@language": "ar"
        },
        {
          "@value": "Plataforma de vigilancia de la salud pública",
          "@language": "es"
        },
        {
          "@value": "Plateforme de surveillance de la santé publique",
          "@language": "fr"
        },
        {
          "@value": "Платформа эпиднадзора в области общественного здравоохранения",
          "@language": "ru"
        },
        {
          "@value": "公共卫生监测平台",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "PHSP",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The Public Health Surveillance Platform is a governed, shared application component for the systematic, ongoing collection, analysis, interpretation, and dissemination of health data to detect, monitor, and respond to public health threats and events.",
          "@language": "en"
        },
        {
          "@value": "منصة ترصد الصحة العامة مكوّن تطبيقي مشترك خاضع للحوكمة للجمع المنهجي والمستمر للبيانات الصحية وتحليلها وتفسيرها ونشرها من أجل كشف التهديدات والأحداث المتعلقة بالصحة العامة ورصدها والاستجابة لها.",
          "@language": "ar"
        },
        {
          "@value": "La Plataforma de vigilancia de la salud pública es un componente de aplicación gobernado y compartido para la recopilación, el análisis, la interpretación y la difusión sistemáticos y continuos de datos de salud con el fin de detectar, vigilar y responder a las amenazas y los eventos de salud pública.",
          "@language": "es"
        },
        {
          "@value": "La plateforme de surveillance de la santé publique est un composant applicatif gouverné et partagé destiné à la collecte, à l'analyse, à l'interprétation et à la diffusion systématiques et continues des données de santé afin de détecter et de suivre les menaces et événements de santé publique et d'y riposter.",
          "@language": "fr"
        },
        {
          "@value": "Платформа эпиднадзора в области общественного здравоохранения — это управляемый общий компонент приложения для систематического, постоянного сбора, анализа, интерпретации и распространения медицинских данных в целях выявления угроз и событий в области общественного здравоохранения, их мониторинга и реагирования на них.",
          "@language": "ru"
        },
        {
          "@value": "公共卫生监测平台是一个受治理的共享应用组件，用于系统、持续地收集、分析、解释和传播卫生数据，以发现、监测和应对公共卫生威胁和事件。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/public-health-surveillance-platform#label-ar"
