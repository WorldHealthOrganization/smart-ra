    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/computable-decision-support-engine",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Computable Decision Support Engine",
          "@language": "en"
        },
        {
          "@value": "محرك دعم القرار القابل للحوسبة",
          "@language": "ar"
        },
        {
          "@value": "Motor computable de apoyo a la decisión",
          "@language": "es"
        },
        {
          "@value": "Moteur d'aide à la décision computable",
          "@language": "fr"
        },
        {
          "@value": "Вычислимый механизм поддержки принятия решений",
          "@language": "ru"
        },
        {
          "@value": "可计算决策支持引擎",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "CDSE",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The Computable Decision Support Engine is a governed, shared application component that delivers context-appropriate, evidence-based guidance at the point of clinical decision-making by applying computable clinical rules and knowledge artefacts to person-specific health data.",
          "@language": "en"
        },
        {
          "@value": "محرك دعم القرار القابل للحوسبة مكوّن تطبيقي مشترك خاضع للحوكمة يقدم إرشادات مسندة بالبيّنات ومناسبة للسياق عند نقطة اتخاذ القرار السريري، من خلال تطبيق القواعد السريرية القابلة للحوسبة والعناصر المعرفية على البيانات الصحية الخاصة بالشخص.",
          "@language": "ar"
        },
        {
          "@value": "El Motor computable de apoyo a la decisión es un componente de aplicación gobernado y compartido que ofrece orientación adecuada al contexto y basada en la evidencia en el momento de la toma de decisiones clínicas, aplicando reglas clínicas computables y artefactos de conocimiento a los datos de salud específicos de cada persona.",
          "@language": "es"
        },
        {
          "@value": "Le moteur d'aide à la décision computable est un composant applicatif gouverné et partagé qui fournit des recommandations adaptées au contexte et fondées sur des données probantes au moment de la prise de décision clinique, en appliquant des règles cliniques et des artefacts de connaissances computables aux données de santé propres à une personne.",
          "@language": "fr"
        },
        {
          "@value": "Вычислимый механизм поддержки принятия решений — это управляемый общий компонент приложения, который предоставляет соответствующие контексту, основанные на фактических данных рекомендации в момент принятия клинических решений, применяя вычислимые клинические правила и артефакты знаний к персональным медицинским данным.",
          "@language": "ru"
        },
        {
          "@value": "可计算决策支持引擎是一个受治理的共享应用组件，通过将可计算临床规则和知识工件应用于个人特定的健康数据，在临床决策点提供适合情境的循证指导。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/computable-decision-support-engine#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/computable-decision-support-engine#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/computable-decision-support-engine#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/computable-decision-support-engine#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/computable-decision-support-engine#label-zh"
        }
      ],
      "skos:notation": "CDSE",
      "skos:scopeNote": "Verbatim lead sentence from Appendix C (Computable Decision Support Engine, 1 What It Is). Abbreviated CDSE throughout the RA draft. A candidate until the RA editors adopt it through the public review.",
      "dcterms:source": "folio/dpi-h-ra/appendix/p-c-business-services-components-computable-decision-support-engi-53a0a5.md",
      "skos:note": "candidate"
    },
