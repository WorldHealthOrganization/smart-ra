        {
          "@value": "Deployment",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Make the software available for use beyond testing purposes.",
          "@language": "en"
        },
        {
          "@value": "إتاحة البرمجيات للاستخدام خارج أغراض الاختبار.",
          "@language": "ar"
        },
        {
          "@value": "Poner el software a disposición para su uso más allá de fines de prueba.",
          "@language": "es"
        },
        {
          "@value": "Rendre le logiciel disponible pour une utilisation au-delà des fins d'essai.",
          "@language": "fr"
        },
        {
          "@value": "Сделать программное обеспечение доступным для использования за пределами целей тестирования.",
          "@language": "ru"
        },
        {
          "@value": "使软件可用于测试目的以外的用途。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
