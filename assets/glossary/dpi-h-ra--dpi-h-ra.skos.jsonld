    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/product-registry",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Product Registry",
          "@language": "en"
        },
        {
          "@value": "سجل المنتجات",
          "@language": "ar"
        },
        {
          "@value": "Registro de productos",
          "@language": "es"
        },
        {
          "@value": "Registre des produits",
          "@language": "fr"
        },
        {
          "@value": "Реестр продукции",
          "@language": "ru"
        },
        {
          "@value": "产品登记库",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "PR",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The Product Registry is the national authoritative source of core identity and classification data for health products — medicines, vaccines, medical devices, diagnostics, and health commodities — recognised for use within a jurisdiction.",
          "@language": "en"
        },
        {
          "@value": "سجل المنتجات هو المصدر الوطني المرجعي للبيانات الأساسية المتعلقة بهوية المنتجات الصحية وتصنيفها — الأدوية واللقاحات والأجهزة الطبية ووسائل التشخيص والسلع الصحية — المعترف باستخدامها ضمن ولاية قضائية ما.",
          "@language": "ar"
        },
        {
          "@value": "El Registro de productos es la fuente nacional autorizada de los datos básicos de identidad y clasificación de los productos de salud —medicamentos, vacunas, dispositivos médicos, medios de diagnóstico y productos básicos de salud— reconocidos para su uso dentro de una jurisdicción.",
          "@language": "es"
        },
        {
          "@value": "Le registre des produits est la source nationale faisant autorité en matière de données essentielles d'identité et de classification des produits de santé — médicaments, vaccins, dispositifs médicaux, produits de diagnostic et produits de santé de base — reconnus pour une utilisation au sein d'une juridiction.",
          "@language": "fr"
        },
        {
          "@value": "Реестр продукции — это национальный авторитетный источник основных данных об идентификации и классификации продукции медицинского назначения — лекарственных средств, вакцин, медицинских изделий, средств диагностики и товаров медицинского назначения, — признанной для использования в пределах юрисдикции.",
          "@language": "ru"
        },
        {
          "@value": "产品登记库是辖区内获准使用的卫生产品——药品、疫苗、医疗器械、诊断产品和卫生商品——的核心身份和分类数据的国家权威来源。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/product-registry#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/product-registry#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/product-registry#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/product-registry#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/product-registry#label-zh"
        }
      ],
      "skos:notation": "PR",
      "skos:scopeNote": "Verbatim lead sentence from Appendix C (Product Registry, 1 What It Is). Also abbreviated PR across the Digital Transformation Handbooks. A candidate until the RA editors adopt it through the public review.",
      "dcterms:source": "folio/dpi-h-ra/appendix/p-c-metadata-registries-and-foundati-product-registry-a3e4b4.md",
      "skos:note": "candidate"
    },
