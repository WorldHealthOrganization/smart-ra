    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/open-architectures",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Open Architectures",
          "@language": "en"
        },
        {
          "@value": "البنى المفتوحة",
          "@language": "ar"
        },
        {
          "@value": "Arquitecturas abiertas",
          "@language": "es"
        },
        {
          "@value": "Architectures ouvertes",
          "@language": "fr"
        },
        {
          "@value": "Открытые архитектуры",
          "@language": "ru"
        },
        {
          "@value": "开放架构",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "open architectures",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Open architectures refer to high-level specifications of technical designs that provide blueprints for creating open ecosystems structured into reusable and shareable components.",
          "@language": "en"
        },
        {
          "@value": "تشير البنى المفتوحة إلى مواصفات رفيعة المستوى للتصاميم التقنية توفر مخططات أساسية لإنشاء منظومات مفتوحة مهيكلة في مكونات قابلة لإعادة الاستخدام والمشاركة.",
          "@language": "ar"
        },
        {
          "@value": "Las arquitecturas abiertas se refieren a especificaciones de alto nivel de diseños técnicos que proporcionan planos para crear ecosistemas abiertos estructurados en componentes reutilizables y compartibles.",
          "@language": "es"
        },
        {
          "@value": "Les architectures ouvertes désignent des spécifications de haut niveau de conceptions techniques qui fournissent des plans directeurs pour la création d'écosystèmes ouverts structurés en composants réutilisables et partageables.",
          "@language": "fr"
        },
        {
          "@value": "Открытые архитектуры — это высокоуровневые спецификации технических проектов, которые служат типовыми планами для создания открытых экосистем, структурированных в виде многократно используемых и совместно используемых компонентов.",
          "@language": "ru"
        },
        {
          "@value": "开放架构是指技术设计的高层次规范，为创建结构化为可重用、可共享组件的开放生态系统提供蓝图。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/open-architectures#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/open-architectures#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/open-architectures#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/open-architectures#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/open-architectures#label-zh"
        }
      ],
      "skos:scopeNote": "RA §2.2.2 body wording, verbatim (library/who-dpi-h-reference-architecture-draft-v1/sections/sec-022-222-the-enabling-conditions-for-reddhi.md, p. 35–39), citing Mehl et al. 2023 (library/mehl-2023-full-stac-oqad018/, glossary/full-stac.glossary.json: \"High-level specifications of technical designs that provide blueprints for creating open ecosystems structured into reusable and shareable components, such as within a health information exchange.\"). Linked via exactMatch to the full-STAC scheme (smart-ra#133 S1, smart-ra#143).",
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/full-stac"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/open-standards"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/open-technologies"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/open-content"
        }
      ],
      "skos:exactMatch": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/full-stac/open-architectures"
        }
      ],
