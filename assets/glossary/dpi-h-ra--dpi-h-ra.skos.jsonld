    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/outcome",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Outcome",
          "@language": "en"
        },
        {
          "@value": "الحصيلة",
          "@language": "ar"
        },
        {
          "@value": "Resultado",
          "@language": "es"
        },
        {
          "@value": "Résultat",
          "@language": "fr"
        },
        {
          "@value": "Результат",
          "@language": "ru"
        },
        {
          "@value": "成果",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "An end result or consequence of a set of activities; an outcome is often measurable and signals progress towards a goal.",
          "@language": "en"
        },
        {
          "@value": "نتيجة نهائية أو عاقبة لمجموعة من الأنشطة؛ وغالبًا ما تكون الحصيلة قابلة للقياس وتدل على التقدم نحو هدف ما.",
          "@language": "ar"
        },
        {
          "@value": "Resultado final o consecuencia de un conjunto de actividades; un resultado suele ser medible e indica el avance hacia un objetivo.",
          "@language": "es"
        },
        {
          "@value": "Résultat final ou conséquence d'un ensemble d'activités ; un résultat est souvent mesurable et signale des progrès vers un objectif.",
          "@language": "fr"
        },
        {
          "@value": "Конечный результат или следствие совокупности действий; результат часто поддается измерению и сигнализирует о продвижении к цели.",
          "@language": "ru"
        },
        {
          "@value": "一组活动的最终结果或后果；成果通常可衡量，并标志着朝向目标取得的进展。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/outcome#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/outcome#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/outcome#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/outcome#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/outcome#label-zh"
        }
      ],
      "skos:scopeNote": "The RA draft's own glossary wording, verbatim (folio/dpi-h-ra/glossary/t-glossary-lead-a31853.md). Wording alternative in RA Table 3.1 (library/who-dpi-h-reference-architecture-draft-v1/sections/sec-026-31-the-architecture-description-approach.md): \"An achieved, and often measurable, result that signals progress towards a goal.\" Both are recorded as candidates; neither is chosen (smart-ra#133 S1).",
      "skos:example": [
        {
          "@value": "A defined share of citizens issued with a verifiable health record.",
          "@language": "en"
        }
      ],
      "dcterms:source": "folio/dpi-h-ra/glossary/t-glossary-lead-a31853.md",
      "skos:note": "candidate"
    },
