      "skos:altLabel": [
        {
          "@value": "full-STAC",
          "@language": "en"
        },
        {
          "@value": "Full Standards, Technologies, Architectures, and Content",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An ecosystem specifying open standards, open technologies, open architectures, and open content (full-STAC).",
          "@language": "en"
        },
        {
          "@value": "منظومة تحدد المعايير المفتوحة والتكنولوجيات المفتوحة والبنى المفتوحة والمحتوى المفتوح (full-STAC).",
          "@language": "ar"
        },
        {
          "@value": "Ecosistema que especifica estándares abiertos, tecnologías abiertas, arquitecturas abiertas y contenido abierto (full-STAC).",
          "@language": "es"
        },
        {
          "@value": "Écosystème spécifiant des normes ouvertes, des technologies ouvertes, des architectures ouvertes et des contenus ouverts (full-STAC).",
          "@language": "fr"
        },
        {
          "@value": "Экосистема, определяющая открытые стандарты, открытые технологии, открытые архитектуры и открытый контент (full-STAC).",
          "@language": "ru"
        },
        {
          "@value": "一个规定开放标准、开放技术、开放架构和开放内容的生态系统（full-STAC）。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
