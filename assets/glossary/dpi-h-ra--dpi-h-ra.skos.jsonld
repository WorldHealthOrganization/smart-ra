    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/data-dictionary",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Data Dictionary",
          "@language": "en"
        },
        {
          "@value": "قاموس البيانات",
          "@language": "ar"
        },
        {
          "@value": "Diccionario de datos",
          "@language": "es"
        },
        {
          "@value": "Dictionnaire de données",
          "@language": "fr"
        },
        {
          "@value": "Словарь данных",
          "@language": "ru"
        },
        {
          "@value": "数据字典",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "data dictionary",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A singular storage location for information about the data elements, detailing their type and definition, relationships, origin and use.",
          "@language": "en"
        },
        {
          "@value": "موقع تخزين واحد للمعلومات المتعلقة بعناصر البيانات، يفصّل نوعها وتعريفها وعلاقاتها ومصدرها واستخدامها.",
          "@language": "ar"
        },
        {
          "@value": "Lugar único de almacenamiento de la información sobre los elementos de datos, que detalla su tipo y definición, sus relaciones, su origen y su uso.",
          "@language": "es"
        },
        {
          "@value": "Emplacement de stockage unique des informations relatives aux éléments de données, précisant leur type et leur définition, leurs relations, leur origine et leur utilisation.",
          "@language": "fr"
        },
        {
          "@value": "Единое место хранения информации об элементах данных с подробным описанием их типа и определения, взаимосвязей, происхождения и использования.",
          "@language": "ru"
        },
        {
          "@value": "关于数据元信息的单一存储位置，详细说明数据元的类型和定义、关系、来源和用途。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
