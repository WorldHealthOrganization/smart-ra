    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/supplier-registry",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Supplier Registry",
          "@language": "en"
        },
        {
          "@value": "سجل الموردين",
          "@language": "ar"
        },
        {
          "@value": "Registro de proveedores",
          "@language": "es"
        },
        {
          "@value": "Registre des fournisseurs",
          "@language": "fr"
        },
        {
          "@value": "Реестр поставщиков",
          "@language": "ru"
        },
        {
          "@value": "供应商登记库",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "SR",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The Supplier Registry is the authoritative master data source for identity, classification, and regulatory status of suppliers engaged in the health supply chain — including manufacturers, distributors, wholesalers, third-party logistics providers, importers, and procurement agents.",
          "@language": "en"
        },
        {
          "@value": "سجل الموردين هو مصدر البيانات الرئيسية المرجعي لهوية الموردين المشاركين في سلسلة الإمداد الصحية وتصنيفهم ووضعهم التنظيمي — بمن فيهم الجهات المصنّعة والموزعون وتجار الجملة ومقدمو الخدمات اللوجستية من الأطراف الثالثة والمستوردون ووكلاء الشراء.",
          "@language": "ar"
        },
        {
          "@value": "El Registro de proveedores es la fuente autorizada de datos maestros sobre la identidad, la clasificación y la situación reglamentaria de los proveedores que participan en la cadena de suministro de salud, incluidos fabricantes, distribuidores, mayoristas, proveedores de logística de terceros, importadores y agentes de adquisiciones.",
          "@language": "es"
        },
        {
          "@value": "Le registre des fournisseurs est la source de données de référence faisant autorité en matière d'identité, de classification et de statut réglementaire des fournisseurs intervenant dans la chaîne d'approvisionnement sanitaire — y compris les fabricants, distributeurs, grossistes, prestataires logistiques tiers, importateurs et agents d'approvisionnement.",
          "@language": "fr"
        },
        {
          "@value": "Реестр поставщиков — это авторитетный источник мастер-данных об идентификации, классификации и регуляторном статусе поставщиков, участвующих в цепочке поставок в здравоохранении, — включая производителей, дистрибьюторов, оптовых торговцев, сторонних логистических операторов, импортеров и агентов по закупкам.",
          "@language": "ru"
        },
        {
          "@value": "供应商登记库是参与卫生供应链的供应商——包括制造商、分销商、批发商、第三方物流提供商、进口商和采购代理——的身份、分类和监管状态的权威主数据来源。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/supplier-registry#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/supplier-registry#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/supplier-registry#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/supplier-registry#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/supplier-registry#label-zh"
        }
      ],
      "skos:notation": "SR",
      "skos:scopeNote": "Verbatim lead sentence from Appendix C (Supplier Registry, 1 What It Is). A candidate until the RA editors adopt it through the public review.",
      "dcterms:source": "folio/dpi-h-ra/appendix/p-c-business-services-components-supplier-registry-c1132a.md",
