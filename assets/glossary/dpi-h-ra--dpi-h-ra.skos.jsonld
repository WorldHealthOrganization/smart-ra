    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-information-system",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Health Information System",
          "@language": "en"
        },
        {
          "@value": "نظام المعلومات الصحية",
          "@language": "ar"
        },
        {
          "@value": "Sistema de información de salud",
          "@language": "es"
        },
        {
          "@value": "Système d'information sanitaire",
          "@language": "fr"
        },
        {
          "@value": "Информационная система здравоохранения",
          "@language": "ru"
        },
        {
          "@value": "卫生信息系统",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "HIS",
          "@language": "en"
        },
        {
          "@value": "health information system",
          "@language": "en"
        },
        {
          "@value": "Health Information System (HIS)",
          "@language": "en"
        },
        {
          "@value": "Health Information Systems",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A system that integrates data collection, processing, reporting, and use of the information necessary for improving health service effectiveness and efficiency through better management at all levels of health services.",
          "@language": "en"
        },
        {
          "@value": "نظام يدمج جمع البيانات ومعالجتها والإبلاغ عنها واستخدام المعلومات اللازمة لتحسين فعالية الخدمات الصحية وكفاءتها من خلال إدارة أفضل على جميع مستويات الخدمات الصحية.",
          "@language": "ar"
        },
        {
          "@value": "Sistema que integra la recopilación, el procesamiento, la notificación y el uso de la información necesaria para mejorar la eficacia y la eficiencia de los servicios de salud mediante una mejor gestión en todos los niveles de los servicios de salud.",
          "@language": "es"
        },
        {
          "@value": "Système qui intègre la collecte, le traitement et la communication des données ainsi que l'utilisation des informations nécessaires pour améliorer l'efficacité et l'efficience des services de santé grâce à une meilleure gestion à tous les niveaux des services de santé.",
          "@language": "fr"
        },
        {
          "@value": "Система, объединяющая сбор, обработку и представление данных, а также использование информации, необходимой для повышения результативности и эффективности медицинских услуг за счет более качественного управления на всех уровнях служб здравоохранения.",
          "@language": "ru"
        },
        {
          "@value": "一种整合数据收集、处理、报告和信息使用的系统，这些信息是通过在卫生服务各级加强管理来提高卫生服务有效性和效率所必需的。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-information-system#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-information-system#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-information-system#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-information-system#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-information-system#label-zh"
        }
      ],
      "skos:notation": "HIS",
      "skos:scopeNote": "DIIG Annex 1.1 Glossary wording, verbatim (who-iris/library/9789240010567-eng/sections/page-140.md, p. 128, citing WHO 2004 Developing health management information systems; also abbreviated in DIIG page-011.md and HRH handbook who-iris/library/9789240062627-eng/sections/page-006.md). The PHC handbook (who-iris/library/9789240093362-eng) has no HIS abbreviation or definition; a wording earlier attributed to it here is not in its text and was removed (smart-ra#200). Referenced in SFP handbook glossary under SMART Guidelines (who-iris/library/9789240120747-eng/sections/sec-002-glossary.md, page-011.md, p. 11) and Ch. 4 (who-iris/library/9789240120747-eng/sections/sec-021-4-determine-the-requirements.md, page-035.md, p. 23). The definition is recorded as a candidate (smart-ra#133 S1, dth-sfp#1 P2).",
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-digital-public-infrastructure"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-information-exchange"
        }
      ],
      "dcterms:source": "who-iris/library/9789240010567-eng/sections/page-140.md",
      "skos:note": "candidate"
    },
