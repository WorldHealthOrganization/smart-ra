    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/business-domain",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Business Domain",
          "@language": "en"
        },
        {
          "@value": "مجال الأعمال",
          "@language": "ar"
        },
        {
          "@value": "Dominio de negocio",
          "@language": "es"
        },
        {
          "@value": "Domaine métier",
          "@language": "fr"
        },
        {
          "@value": "Бизнес-домен",
          "@language": "ru"
        },
        {
          "@value": "业务领域",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "A specific focus area or subsystem within a broader business system, characterized by its own essential attributes",
          "@language": "en"
        },
        {
          "@value": "مجال تركيز محدد أو نظام فرعي ضمن نظام أعمال أوسع، يتسم بخصائصه الجوهرية الخاصة",
          "@language": "ar"
        },
        {
          "@value": "Área de interés o subsistema específico dentro de un sistema de negocio más amplio, caracterizado por sus propios atributos esenciales",
          "@language": "es"
        },
        {
          "@value": "Domaine d'intervention ou sous-système spécifique au sein d'un système métier plus large, caractérisé par ses propres attributs essentiels",
          "@language": "fr"
        },
        {
          "@value": "Конкретная область внимания или подсистема в рамках более широкой бизнес-системы, характеризующаяся собственными существенными атрибутами",
          "@language": "ru"
        },
        {
          "@value": "更广泛业务系统中的特定关注领域或子系统，具有其自身的基本属性",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/business-domain#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/business-domain#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/business-domain#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/business-domain#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/business-domain#label-zh"
        }
      ],
      "skos:scopeNote": "The RA draft's own wording, verbatim. A candidate until the RA editors adopt it through the public review. The draft marks this entry [Under review].",
      "skos:editorialNote": "Under review",
