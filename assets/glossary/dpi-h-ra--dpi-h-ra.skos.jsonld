    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/client-registry",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Client Registry",
          "@language": "en"
        },
        {
          "@value": "سجل المستفيدين",
          "@language": "ar"
        },
        {
          "@value": "Registro de clientes",
          "@language": "es"
        },
        {
          "@value": "Registre des clients",
          "@language": "fr"
        },
        {
          "@value": "Реестр клиентов",
          "@language": "ru"
        },
        {
          "@value": "服务对象登记库",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "CR",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The Client Registry is the national authoritative source of health-specific person identity. It is the foundational health-sector component that maintains a unique, verifiable identity record for every person who accesses or is eligible to access health services within a jurisdiction.",
          "@language": "en"
        },
        {
          "@value": "سجل المستفيدين هو المصدر الوطني المرجعي لهوية الأشخاص الخاصة بالصحة. وهو المكوّن التأسيسي في القطاع الصحي الذي يحتفظ بسجل هوية فريد قابل للتحقق لكل شخص يصل إلى الخدمات الصحية أو يحق له الوصول إليها ضمن ولاية قضائية ما.",
          "@language": "ar"
        },
        {
          "@value": "El Registro de clientes es la fuente nacional autorizada de la identidad de las personas específica del ámbito de la salud. Es el componente fundacional del sector de la salud que mantiene un registro de identidad único y verificable de cada persona que accede o tiene derecho a acceder a los servicios de salud dentro de una jurisdicción.",
          "@language": "es"
        },
        {
          "@value": "Le registre des clients est la source nationale faisant autorité en matière d'identité des personnes propre au secteur de la santé. Il s'agit du composant fondamental du secteur de la santé qui tient à jour un dossier d'identité unique et vérifiable pour chaque personne qui accède ou est en droit d'accéder aux services de santé au sein d'une juridiction.",
          "@language": "fr"
        },
        {
          "@value": "Реестр клиентов — это национальный авторитетный источник специфичной для здравоохранения идентификационной информации о человеке. Это базовый компонент сектора здравоохранения, который ведет уникальную, поддающуюся проверке идентификационную запись для каждого человека, который получает или имеет право получать услуги здравоохранения в пределах юрисдикции.",
          "@language": "ru"
        },
        {
          "@value": "服务对象登记库是卫生领域个人身份的国家权威来源。它是卫生部门的基础组件，为辖区内每一位获得或有资格获得卫生服务的人维护唯一、可核实的身份记录。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/client-registry#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/client-registry#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/client-registry#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/client-registry#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/client-registry#label-zh"
        }
      ],
      "skos:notation": "CR",
      "skos:scopeNote": "Verbatim lead sentence from Appendix C (Client Registry, 1 What It Is). Also abbreviated CR in the OpenHIE requirement identifiers (CRF-*, CRWF-*) and downstream Digital Transformation Handbooks. A candidate until the RA editors adopt it through the public review.",
      "dcterms:source": "folio/dpi-h-ra/appendix/p-c-metadata-registries-and-foundati-client-registry-95ffd8.md",
      "skos:note": "candidate"
    },
