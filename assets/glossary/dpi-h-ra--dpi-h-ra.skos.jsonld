      "skosxl:literalForm": {
        "@value": "Servicio de terminología",
        "@language": "es"
      },
      "fa:translationStatus": "unofficial"
    },
    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/terminology-service#label-fr",
      "@type": "skosxl:Label",
      "skosxl:literalForm": {
        "@value": "Service de terminologie",
        "@language": "fr"
