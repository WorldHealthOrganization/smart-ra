    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/registry",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Registry",
          "@language": "en"
        },
        {
          "@value": "السجل",
          "@language": "ar"
        },
        {
          "@value": "Registro",
          "@language": "es"
        },
        {
          "@value": "Registre",
          "@language": "fr"
        },
        {
          "@value": "Реестр",
          "@language": "ru"
        },
        {
          "@value": "登记库",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "registry",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A governed, authoritative and centralized information system that captures, stores and maintains the unique attributes and identifiers of health facilities, health service users, health products and/or the health workforce using a predefined canonical minimum data set.",
          "@language": "en"
        },
        {
          "@value": "نظام معلومات مركزي خاضع للحوكمة ومرجعي، يلتقط ويخزن ويحفظ الخصائص الفريدة والمعرّفات الخاصة بالمرافق الصحية ومستخدمي الخدمات الصحية والمنتجات الصحية و/أو القوى العاملة الصحية، باستخدام مجموعة بيانات دنيا مرجعية محددة مسبقًا.",
          "@language": "ar"
        },
        {
          "@value": "Sistema de información gobernado, autorizado y centralizado que recopila, almacena y mantiene los atributos e identificadores únicos de los establecimientos de salud, los usuarios de los servicios de salud, los productos de salud y/o el personal de salud utilizando un conjunto mínimo de datos canónico predefinido.",
          "@language": "es"
        },
        {
          "@value": "Système d'information gouverné, faisant autorité et centralisé, qui saisit, stocke et tient à jour les attributs et identifiants uniques des établissements de santé, des usagers des services de santé, des produits de santé et/ou des personnels de santé à l'aide d'un ensemble minimal de données canonique prédéfini.",
          "@language": "fr"
        },
        {
          "@value": "Управляемая, авторитетная и централизованная информационная система, которая фиксирует, хранит и поддерживает уникальные атрибуты и идентификаторы медицинских учреждений, пользователей услуг здравоохранения, продукции медицинского назначения и/или кадров здравоохранения с использованием заранее определенного канонического минимального набора данных.",
          "@language": "ru"
        },
        {
          "@value": "一种受治理的、权威的集中式信息系统，使用预定义的规范最小数据集，采集、存储和维护卫生机构、卫生服务使用者、卫生产品和/或卫生人力的唯一属性和标识符。",
          "@language": "zh"
        }
      ],
