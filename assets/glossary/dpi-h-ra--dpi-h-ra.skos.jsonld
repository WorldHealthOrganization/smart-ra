    },
    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-facility-registry#label-ru",
      "@type": "skosxl:Label",
      "skosxl:literalForm": {
        "@value": "Реестр медицинских учреждений",
        "@language": "ru"
      },
      "fa:translationStatus": "unofficial"
    },
    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-facility-registry#label-zh",
      "@type": "skosxl:Label",
