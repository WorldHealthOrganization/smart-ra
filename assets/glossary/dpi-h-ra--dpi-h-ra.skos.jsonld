    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/value",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Value",
          "@language": "en"
        },
        {
          "@value": "القيمة",
          "@language": "ar"
        },
        {
          "@value": "Valor",
          "@language": "es"
        },
        {
          "@value": "Valeur",
          "@language": "fr"
        },
        {
          "@value": "Ценность",
          "@language": "ru"
        },
        {
          "@value": "价值",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "The benefit or utility a stakeholder gains from using a service, product, or capability.",
          "@language": "en"
        },
        {
          "@value": "المنفعة أو الفائدة التي يجنيها صاحب المصلحة من استخدام خدمة أو منتج أو قدرة.",
          "@language": "ar"
        },
        {
          "@value": "Beneficio o utilidad que obtiene una parte interesada al utilizar un servicio, un producto o una capacidad.",
          "@language": "es"
        },
        {
          "@value": "Avantage ou utilité qu'une partie prenante retire de l'utilisation d'un service, d'un produit ou d'une capacité.",
          "@language": "fr"
        },
        {
          "@value": "Выгода или полезность, которую заинтересованная сторона получает от использования сервиса, продукта или возможности.",
          "@language": "ru"
        },
        {
          "@value": "利益攸关方通过使用服务、产品或能力而获得的收益或效用。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/value#label-ar"
        },
        {
