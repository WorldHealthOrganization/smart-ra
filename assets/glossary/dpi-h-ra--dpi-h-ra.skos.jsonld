    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/open-content",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Open Content",
          "@language": "en"
        },
        {
          "@value": "المحتوى المفتوح",
          "@language": "ar"
        },
        {
          "@value": "Contenido abierto",
          "@language": "es"
        },
        {
          "@value": "Contenu ouvert",
          "@language": "fr"
        },
        {
          "@value": "Открытый контент",
          "@language": "ru"
        },
        {
          "@value": "开放内容",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "open content",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Open content refers to domain ideas and synthesized knowledge clearly documented without restrictions inhibiting readability or usage.",
          "@language": "en"
        },
        {
          "@value": "يشير المحتوى المفتوح إلى أفكار المجال والمعارف المجمّعة الموثقة بوضوح دون قيود تعيق قابليتها للقراءة أو الاستخدام.",
          "@language": "ar"
        },
        {
          "@value": "El contenido abierto se refiere a ideas del dominio y conocimientos sintetizados documentados con claridad, sin restricciones que impidan su legibilidad o su uso.",
          "@language": "es"
        },
        {
          "@value": "Le contenu ouvert désigne des idées du domaine et des connaissances synthétisées, clairement documentées, sans restrictions entravant leur lisibilité ou leur utilisation.",
          "@language": "fr"
        },
        {
          "@value": "Открытый контент — это идеи в предметной области и обобщенные знания, четко задокументированные без ограничений, препятствующих их прочтению или использованию.",
          "@language": "ru"
        },
        {
          "@value": "开放内容是指清晰记录、在可读性或使用方面不受限制的领域思想和综合知识。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/open-content#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/open-content#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/open-content#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/open-content#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/open-content#label-zh"
        }
      ],
      "skos:scopeNote": "RA §2.2.2 body wording, verbatim (library/who-dpi-h-reference-architecture-draft-v1/sections/sec-022-222-the-enabling-conditions-for-reddhi.md, p. 35–39), citing Mehl et al. 2023 (library/mehl-2023-full-stac-oqad018/, glossary/full-stac.glossary.json: \"Domain ideas and synthesized knowledge clearly documented without restrictions inhibiting readability or usage, such as health guidelines, workflows, core data elements, terminology mappings, and test cases aligned to standards.\"). Linked via exactMatch to the full-STAC scheme (smart-ra#133 S1, smart-ra#143).",
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/full-stac"
        },
        {
