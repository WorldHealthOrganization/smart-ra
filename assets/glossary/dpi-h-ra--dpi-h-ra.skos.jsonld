    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/application-component",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Application Component",
          "@language": "en"
        },
        {
          "@value": "المكوّن التطبيقي",
          "@language": "ar"
        },
        {
          "@value": "Componente de aplicación",
          "@language": "es"
        },
        {
          "@value": "Composant applicatif",
          "@language": "fr"
        },
        {
          "@value": "Компонент приложения",
          "@language": "ru"
        },
        {
          "@value": "应用组件",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "A deployable, modular piece of software that provides a defined set of functionality and holds the data it manages, exposing both through services.",
          "@language": "en"
        },
        {
          "@value": "جزء برمجي نمطي قابل للنشر، يوفر مجموعة محددة من الوظائف ويحتفظ بالبيانات التي يديرها، ويتيح كليهما من خلال الخدمات.",
          "@language": "ar"
        },
        {
          "@value": "Pieza de software modular y desplegable que proporciona un conjunto definido de funcionalidades y alberga los datos que gestiona, exponiendo ambos a través de servicios.",
          "@language": "es"
        },
        {
          "@value": "Élément logiciel modulaire et déployable qui fournit un ensemble défini de fonctionnalités et détient les données qu'il gère, exposant les unes et les autres au moyen de services.",
          "@language": "fr"
        },
        {
          "@value": "Развертываемая модульная единица программного обеспечения, которая предоставляет определенный набор функциональных возможностей и хранит данные, которыми она управляет, делая и то и другое доступным через сервисы.",
          "@language": "ru"
        },
        {
          "@value": "一种可部署的模块化软件，提供一组明确的功能并持有其所管理的数据，二者均通过服务对外提供。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/application-component#label-ar"
