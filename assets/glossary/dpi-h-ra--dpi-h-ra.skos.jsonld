    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/electronic-medical-record",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Electronic Medical Record",
          "@language": "en"
        },
        {
          "@value": "السجل الطبي الإلكتروني",
          "@language": "ar"
        },
        {
          "@value": "Registro médico electrónico",
          "@language": "es"
        },
        {
          "@value": "Dossier médical électronique",
          "@language": "fr"
        },
        {
          "@value": "Электронная медицинская карта",
          "@language": "ru"
        },
        {
          "@value": "电子病历",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "EMR",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An electronic record of health-related information that can be created, gathered, managed, and consulted by authorised clinicians and staff within one health care organisation.",
          "@language": "en"
        },
        {
          "@value": "سجل إلكتروني للمعلومات المتعلقة بالصحة يمكن إنشاؤه وجمعه وإدارته والاطلاع عليه من قِبل الأطباء السريريين والموظفين المأذون لهم داخل مؤسسة رعاية صحية واحدة.",
          "@language": "ar"
        },
        {
          "@value": "Registro electrónico de información relacionada con la salud que puede ser creado, recopilado, gestionado y consultado por médicos y otros profesionales clínicos y personal autorizados dentro de una organización de atención de salud.",
          "@language": "es"
        },
        {
          "@value": "Dossier électronique d'informations relatives à la santé qui peut être créé, recueilli, géré et consulté par des cliniciens et du personnel autorisés au sein d'une même organisation de soins de santé.",
          "@language": "fr"
        },
        {
          "@value": "Электронная запись медицинской информации, которая может создаваться, собираться, вестись и просматриваться уполномоченными клиницистами и персоналом в пределах одной организации здравоохранения.",
          "@language": "ru"
        },
        {
          "@value": "一种与健康相关信息的电子记录，可由一个卫生保健组织内经授权的临床医生和工作人员创建、收集、管理和查阅。",
          "@language": "zh"
        }
      ],
