    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/logical-observation-identifiers-names-and-codes",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Logical Observation Identifiers Names and Codes",
          "@language": "en"
        },
        {
          "@value": "Logical Observation Identifiers Names and Codes",
          "@language": "ar"
        },
        {
          "@value": "Logical Observation Identifiers Names and Codes",
