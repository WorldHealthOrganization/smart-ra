    },
    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-workforce-registry",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Health Workforce Registry",
          "@language": "en"
        },
        {
          "@value": "سجل القوى العاملة الصحية",
          "@language": "ar"
        },
        {
          "@value": "Registro del personal de salud",
          "@language": "es"
        },
        {
          "@value": "Registre des personnels de santé",
          "@language": "fr"
        },
        {
          "@value": "Реестр кадров здравоохранения",
          "@language": "ru"
        },
        {
          "@value": "卫生人力登记库",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "HWR",
          "@language": "en"
        },
        {
          "@value": "Health Worker Registry",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The Health Workforce Registry is the national authoritative record of identity, credential, and classification data for all health workers recognised as part of the national health workforce — including licensed or certified clinical professionals, community health workers, allied health personnel, and administrative and management staff in health-related roles.",
          "@language": "en"
        },
        {
          "@value": "سجل القوى العاملة الصحية هو السجل الوطني المرجعي لبيانات الهوية والمؤهلات والتصنيف لجميع العاملين الصحيين المعترف بهم بوصفهم جزءًا من القوى العاملة الصحية الوطنية — بمن فيهم المهنيون السريريون المرخصون أو المعتمدون، والعاملون الصحيون المجتمعيون، والعاملون في المهن الصحية المساندة، وموظفو الشؤون الإدارية والإدارة في الأدوار المتصلة بالصحة.",
          "@language": "ar"
        },
        {
          "@value": "El Registro del personal de salud es el registro nacional autorizado de los datos de identidad, acreditación y clasificación de todos los trabajadores de salud reconocidos como parte del personal de salud nacional, incluidos los profesionales clínicos con licencia o certificación, los agentes de salud comunitarios, el personal de salud afín y el personal administrativo y directivo en funciones relacionadas con la salud.",
          "@language": "es"
        },
        {
          "@value": "Le registre des personnels de santé est le registre national faisant autorité des données d'identité, de qualification et de classification de tous les agents de santé reconnus comme faisant partie des personnels de santé nationaux — y compris les professionnels cliniques agréés ou certifiés, les agents de santé communautaires, les personnels paramédicaux et le personnel administratif et de direction occupant des fonctions liées à la santé.",
          "@language": "fr"
        },
        {
          "@value": "Реестр кадров здравоохранения — это национальная авторитетная запись данных об идентификации, квалификационных документах и классификации всех работников здравоохранения, признанных частью национальных кадров здравоохранения, — включая лицензированных или сертифицированных клинических специалистов, общинных медицинских работников, смежный медицинский персонал, а также административный и управленческий персонал на должностях, связанных со здравоохранением.",
          "@language": "ru"
        },
        {
          "@value": "卫生人力登记库是被认定为国家卫生人力组成部分的所有卫生工作者的身份、资质和分类数据的国家权威记录——包括获得执照或认证的临床专业人员、社区卫生工作者、专职卫生人员以及担任卫生相关职务的行政和管理人员。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-workforce-registry#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-workforce-registry#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-workforce-registry#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-workforce-registry#label-ru"
        },
