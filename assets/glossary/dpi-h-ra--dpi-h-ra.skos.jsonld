    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/product",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Product",
          "@language": "en"
        },
        {
          "@value": "المنتَج",
          "@language": "ar"
        },
        {
          "@value": "Producto",
          "@language": "es"
        },
        {
          "@value": "Produit",
          "@language": "fr"
        },
        {
          "@value": "Продукт",
          "@language": "ru"
        },
        {
          "@value": "产品",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "A concrete offering, bundling services and data, that is made available to stakeholders.",
          "@language": "en"
        },
        {
          "@value": "عرض ملموس يجمع بين الخدمات والبيانات، ويُتاح لأصحاب المصلحة.",
          "@language": "ar"
        },
        {
          "@value": "Oferta concreta, que agrupa servicios y datos, que se pone a disposición de las partes interesadas.",
          "@language": "es"
        },
        {
          "@value": "Offre concrète, regroupant des services et des données, mise à la disposition des parties prenantes.",
          "@language": "fr"
        },
        {
          "@value": "Конкретное предложение, объединяющее сервисы и данные, которое предоставляется заинтересованным сторонам.",
          "@language": "ru"
        },
        {
          "@value": "一种捆绑服务和数据、向利益攸关方提供的具体提供物。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/product#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/product#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/product#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/product#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/product#label-zh"
        }
      ],
      "skos:scopeNote": "The RA draft's own glossary wording, verbatim (folio/dpi-h-ra/glossary/t-glossary-lead-a31853.md). Wording alternative in RA Table 3.1 (library/who-dpi-h-reference-architecture-draft-v1/sections/sec-026-31-the-architecture-description-approach.md): \"A coherent offering that bundles services and data for use by stakeholders.\" Note: in the PC (9789240116191-eng) and SFP (9789240120747-eng) handbooks, the bare word 'product' is used as a synonym for `generic-product` (a health product / medicine); per owner decision 2026-10-31 (smart-ra#142), `product-master-data` and `generic-product` are separate concepts and no homonym split is needed on Product Master Data.",
      "skos:example": [
        {
          "@value": "A digital health wallet.",
          "@language": "en"
        }
      ],
      "dcterms:source": "folio/dpi-h-ra/glossary/t-glossary-lead-a31853.md",
      "skos:note": "candidate"
    },
