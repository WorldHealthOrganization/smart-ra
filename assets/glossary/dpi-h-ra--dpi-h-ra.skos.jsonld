    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-facility-registry",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Health Facility Registry",
          "@language": "en"
        },
        {
          "@value": "سجل المرافق الصحية",
          "@language": "ar"
        },
        {
          "@value": "Registro de establecimientos de salud",
          "@language": "es"
        },
        {
          "@value": "Registre des établissements de santé",
          "@language": "fr"
        },
        {
          "@value": "Реестр медицинских учреждений",
          "@language": "ru"
        },
        {
          "@value": "卫生机构登记库",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "FR",
          "@language": "en"
        },
        {
          "@value": "Facility Registry",
          "@language": "en"
        },
        {
          "@value": "HFR",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The Health Facility Registry is the national authoritative source of identity, location, and classification data for all facilities, locations, and organisations through which health services are delivered or that are otherwise relevant to health system operations.",
          "@language": "en"
        },
        {
          "@value": "سجل المرافق الصحية هو المصدر الوطني المرجعي لبيانات الهوية والموقع والتصنيف لجميع المرافق والمواقع والمؤسسات التي تُقدَّم من خلالها الخدمات الصحية أو التي تكون ذات صلة بخلاف ذلك بعمليات النظام الصحي.",
          "@language": "ar"
        },
        {
          "@value": "El Registro de establecimientos de salud es la fuente nacional autorizada de los datos de identidad, ubicación y clasificación de todos los establecimientos, lugares y organizaciones a través de los cuales se prestan servicios de salud o que son pertinentes de otro modo para el funcionamiento del sistema de salud.",
          "@language": "es"
        },
        {
          "@value": "Le registre des établissements de santé est la source nationale faisant autorité en matière de données d'identité, de localisation et de classification pour l'ensemble des établissements, lieux et organisations par l'intermédiaire desquels des services de santé sont fournis ou qui présentent par ailleurs un intérêt pour le fonctionnement du système de santé.",
          "@language": "fr"
        },
        {
          "@value": "Реестр медицинских учреждений — это национальный авторитетный источник данных об идентификации, местонахождении и классификации всех учреждений, мест и организаций, через которые предоставляются услуги здравоохранения или которые иным образом имеют отношение к функционированию системы здравоохранения.",
          "@language": "ru"
        },
        {
          "@value": "卫生机构登记库是所有提供卫生服务或与卫生系统运作相关的机构、地点和组织的身份、位置和分类数据的国家权威来源。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-facility-registry#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-facility-registry#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-facility-registry#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-facility-registry#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-facility-registry#label-zh"
        }
      ],
      "skos:notation": "FR",
      "skos:scopeNote": "Verbatim lead sentence from Appendix C (Health Facility Registry, 1 What It Is). Abbreviated FR in the OpenHIE Facility Registry specification references (FRF-*, FRWF-*) and FR / HFR across the Digital Transformation Handbooks. A candidate until the RA editors adopt it through the public review.",
      "dcterms:source": "folio/dpi-h-ra/appendix/p-c-metadata-registries-and-foundati-health-facility-registry-069302.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-facility-registry#label-ar",
      "@type": "skosxl:Label",
      "skosxl:literalForm": {
        "@value": "سجل المرافق الصحية",
        "@language": "ar"
      },
      "fa:translationStatus": "unofficial"
    },
    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-facility-registry#label-es",
      "@type": "skosxl:Label",
      "skosxl:literalForm": {
        "@value": "Registro de establecimientos de salud",
        "@language": "es"
      },
      "fa:translationStatus": "unofficial"
    },
    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-facility-registry#label-fr",
      "@type": "skosxl:Label",
      "skosxl:literalForm": {
        "@value": "Registre des établissements de santé",
