      "skos:prefLabel": [
        {
          "@value": "Client",
          "@language": "en"
        },
        {
          "@value": "المستفيد",
          "@language": "ar"
        },
        {
          "@value": "Cliente",
          "@language": "es"
        },
        {
          "@value": "Client",
          "@language": "fr"
        },
        {
          "@value": "Клиент",
          "@language": "ru"
        },
        {
          "@value": "服务对象",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "Members of the public who are potential or current users of health services, including health prevention and wellness activities.",
          "@language": "en"
        },
        {
          "@value": "أفراد الجمهور الذين هم مستخدمون محتملون أو حاليون للخدمات الصحية، بما في ذلك أنشطة الوقاية الصحية والعافية.",
          "@language": "ar"
        },
        {
          "@value": "Miembros del público que son usuarios potenciales o actuales de los servicios de salud, incluidas las actividades de prevención y bienestar.",
          "@language": "es"
        },
        {
          "@value": "Membres du public qui sont des utilisateurs potentiels ou actuels des services de santé, y compris des activités de prévention sanitaire et de bien-être.",
          "@language": "fr"
        },
        {
          "@value": "Представители населения, являющиеся потенциальными или текущими пользователями услуг здравоохранения, включая мероприятия в области профилактики и поддержания благополучия.",
          "@language": "ru"
        },
        {
          "@value": "作为卫生服务（包括健康预防和健康福祉活动）潜在或现有使用者的公众成员。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/client#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/client#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/client#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/client#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/client#label-zh"
        }
      ],
