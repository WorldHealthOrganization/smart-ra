    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/data-governance",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Data Governance",
          "@language": "en"
        },
        {
          "@value": "حوكمة البيانات",
          "@language": "ar"
        },
        {
          "@value": "Gobernanza de datos",
          "@language": "es"
        },
        {
          "@value": "Gouvernance des données",
          "@language": "fr"
        },
        {
          "@value": "Управление данными",
          "@language": "ru"
        },
        {
          "@value": "数据治理",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "The structures and standards (policies & legal frameworks) necessary to coordinate and manage the data journey from collection, storage, sharing, analysis to use to produce trusted, secure and quality data for decision making",
          "@language": "en"
        },
        {
          "@value": "الهياكل والمعايير (السياسات والأطر القانونية) اللازمة لتنسيق وإدارة رحلة البيانات من الجمع والتخزين والمشاركة والتحليل إلى الاستخدام، من أجل إنتاج بيانات موثوقة وآمنة وجيدة النوعية لاتخاذ القرارات",
          "@language": "ar"
        },
        {
          "@value": "Estructuras y normas (políticas y marcos jurídicos) necesarias para coordinar y gestionar el recorrido de los datos, desde la recopilación, el almacenamiento, el intercambio y el análisis hasta su uso, con el fin de producir datos fiables, seguros y de calidad para la toma de decisiones",
          "@language": "es"
        },
        {
          "@value": "Structures et normes (politiques et cadres juridiques) nécessaires pour coordonner et gérer le parcours des données, de la collecte, du stockage, du partage et de l'analyse jusqu'à l'utilisation, afin de produire des données fiables, sécurisées et de qualité pour la prise de décision",
          "@language": "fr"
        },
        {
          "@value": "Структуры и стандарты (политики и правовые рамки), необходимые для координации и управления жизненным путем данных — от сбора, хранения, обмена и анализа до использования — с целью получения достоверных, защищенных и качественных данных для принятия решений",
          "@language": "ru"
        },
        {
          "@value": "协调和管理从收集、存储、共享、分析到使用的数据历程所需的结构和标准（政策和法律框架），以产生用于决策的可信、安全和高质量数据",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/data-governance#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/data-governance#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/data-governance#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/data-governance#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/data-governance#label-zh"
        }
      ],
      "skos:scopeNote": "The RA draft's own wording, verbatim. A candidate until the RA editors adopt it through the public review.",
      "skos:broader": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/governance"
        }
      ],
      "dcterms:source": "folio/dpi-h-ra/glossary/t-glossary-lead-a31853.md",
      "skos:note": "candidate"
