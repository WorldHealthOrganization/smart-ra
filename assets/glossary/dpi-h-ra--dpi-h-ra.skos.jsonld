    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/data-object",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Data Object",
          "@language": "en"
        },
        {
          "@value": "كائن البيانات",
          "@language": "ar"
        },
        {
          "@value": "Objeto de datos",
          "@language": "es"
        },
        {
          "@value": "Objet de données",
          "@language": "fr"
        },
        {
          "@value": "Объект данных",
          "@language": "ru"
        },
        {
          "@value": "数据对象",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "A defined unit of structured data used or produced by an application component.",
          "@language": "en"
        },
        {
          "@value": "وحدة محددة من البيانات المهيكلة يستخدمها مكوّن تطبيقي أو ينتجها.",
          "@language": "ar"
        },
        {
          "@value": "Unidad definida de datos estructurados utilizada o producida por un componente de aplicación.",
          "@language": "es"
        },
        {
          "@value": "Unité définie de données structurées utilisée ou produite par un composant applicatif.",
          "@language": "fr"
        },
        {
          "@value": "Определенная единица структурированных данных, используемая или создаваемая компонентом приложения.",
          "@language": "ru"
        },
        {
          "@value": "应用组件所使用或产生的已定义的结构化数据单元。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/data-object#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/data-object#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/data-object#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/data-object#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/data-object#label-zh"
        }
      ],
      "skos:scopeNote": "The RA draft's own wording, verbatim. A candidate until the RA editors adopt it through the public review.",
      "skos:example": [
        {
          "@value": "A client identity record; a coded entry in the lifelong health record.",
          "@language": "en"
        }
      ],
      "dcterms:source": "folio/dpi-h-ra/glossary/t-glossary-lead-a31853.md",
      "skos:note": "candidate"
    },
