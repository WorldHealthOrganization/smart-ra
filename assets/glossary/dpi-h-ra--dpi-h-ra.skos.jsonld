          "@value": "سير العمل",
          "@language": "ar"
        },
        {
          "@value": "Flujo de trabajo",
          "@language": "es"
        },
        {
          "@value": "Flux de travail",
          "@language": "fr"
        },
        {
          "@value": "Рабочий процесс",
          "@language": "ru"
        },
        {
          "@value": "工作流程",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "workflow",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The sequence of activities from one task to another (see section 3.3).",
          "@language": "en"
        },
        {
          "@value": "تسلسل الأنشطة من مهمة إلى أخرى (انظر القسم 3.3).",
          "@language": "ar"
        },
        {
          "@value": "Secuencia de actividades de una tarea a otra (véase la sección 3.3).",
          "@language": "es"
        },
        {
          "@value": "Enchaînement des activités d'une tâche à une autre (voir la section 3.3).",
          "@language": "fr"
        },
        {
          "@value": "Последовательность действий при переходе от одной задачи к другой (см. раздел 3.3).",
          "@language": "ru"
        },
        {
          "@value": "从一项任务到另一项任务的活动序列（见第3.3节）。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/workflow#label-ar"
        },
