    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/goal",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Goal",
          "@language": "en"
        },
        {
          "@value": "الهدف",
          "@language": "ar"
        },
        {
          "@value": "Objetivo",
          "@language": "es"
        },
        {
          "@value": "Objectif",
          "@language": "fr"
        },
        {
          "@value": "Цель",
          "@language": "ru"
        },
        {
          "@value": "目标",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "A high-level statement of intent, direction, or desired state for an organisation and its stakeholders.",
          "@language": "en"
        },
        {
          "@value": "بيان رفيع المستوى للنية أو الاتجاه أو الحالة المنشودة لمؤسسة ما وأصحاب المصلحة فيها.",
          "@language": "ar"
        },
        {
          "@value": "Declaración de alto nivel de una intención, una dirección o un estado deseado para una organización y sus partes interesadas.",
          "@language": "es"
        },
        {
          "@value": "Énoncé de haut niveau d'une intention, d'une orientation ou d'un état souhaité pour une organisation et ses parties prenantes.",
          "@language": "fr"
        },
        {
          "@value": "Высокоуровневое заявление о намерении, направлении или желаемом состоянии для организации и ее заинтересованных сторон.",
          "@language": "ru"
        },
        {
          "@value": "关于组织及其利益攸关方的意图、方向或期望状态的高层次陈述。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/goal#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/goal#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/goal#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/goal#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/goal#label-zh"
        }
      ],
      "skos:scopeNote": "The RA draft's own wording, verbatim. A candidate until the RA editors adopt it through the public review.",
      "skos:example": [
        {
          "@value": "Universal access to a trusted personal health record.",
          "@language": "en"
        }
      ],
      "dcterms:source": "folio/dpi-h-ra/glossary/t-glossary-lead-a31853.md",
      "skos:note": "candidate"
    },
