    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-management-information-system",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Health Management Information System",
          "@language": "en"
        },
        {
          "@value": "نظام معلومات الإدارة الصحية",
          "@language": "ar"
        },
        {
          "@value": "Sistema de información para la gestión de la salud",
          "@language": "es"
        },
        {
          "@value": "Système d'information pour la gestion sanitaire",
          "@language": "fr"
        },
        {
          "@value": "Информационная система управления здравоохранением",
          "@language": "ru"
        },
        {
          "@value": "卫生管理信息系统",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "HMIS",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The Health Management Information System is a governed, shared application component responsible for the systematic collection, aggregation, analysis, and dissemination of population-level and facility-level health data to support health system planning, performance monitoring, resource allocation, and policy decision-making.",
          "@language": "en"
        },
        {
          "@value": "نظام معلومات الإدارة الصحية مكوّن تطبيقي مشترك خاضع للحوكمة، مسؤول عن الجمع المنهجي للبيانات الصحية على مستوى السكان وعلى مستوى المرافق وتجميعها وتحليلها ونشرها لدعم تخطيط النظام الصحي ورصد الأداء وتخصيص الموارد واتخاذ قرارات السياسات.",
          "@language": "ar"
        },
        {
          "@value": "El Sistema de información para la gestión de la salud es un componente de aplicación gobernado y compartido responsable de la recopilación, agregación, análisis y difusión sistemáticos de datos de salud a nivel de la población y de los establecimientos para apoyar la planificación del sistema de salud, el seguimiento del desempeño, la asignación de recursos y la toma de decisiones sobre políticas.",
          "@language": "es"
        },
        {
          "@value": "Le système d'information pour la gestion sanitaire est un composant applicatif gouverné et partagé chargé de la collecte, de l'agrégation, de l'analyse et de la diffusion systématiques des données de santé au niveau de la population et des établissements, afin d'appuyer la planification du système de santé, le suivi de la performance, l'allocation des ressources et la prise de décision politique.",
          "@language": "fr"
        },
        {
          "@value": "Информационная система управления здравоохранением — это управляемый общий компонент приложения, отвечающий за систематический сбор, агрегирование, анализ и распространение медицинских данных на уровне населения и на уровне учреждений для поддержки планирования системы здравоохранения, мониторинга эффективности ее деятельности, распределения ресурсов и принятия политических решений.",
          "@language": "ru"
        },
        {
          "@value": "卫生管理信息系统是一个受治理的共享应用组件，负责系统地收集、汇总、分析和传播人群层面和机构层面的卫生数据，以支持卫生系统规划、绩效监测、资源分配和政策决策。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-management-information-system#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-management-information-system#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-management-information-system#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-management-information-system#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/health-management-information-system#label-zh"
        }
      ],
      "skos:notation": "HMIS",
      "skos:scopeNote": "Lead sentence from Appendix C (Health Management Information System, 1 What It Is). Abbreviated HMIS throughout the RA draft and downstream Digital Transformation Handbooks. A candidate until the RA editors adopt it through the public review.",
      "dcterms:source": "folio/dpi-h-ra/appendix/p-c-business-services-components-health-management-information-sy-9dea8c.md",
      "skos:note": "candidate"
    },
