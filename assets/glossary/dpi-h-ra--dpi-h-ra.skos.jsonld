    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/use-case",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Use Case",
          "@language": "en"
        },
        {
          "@value": "حالة الاستخدام",
          "@language": "ar"
        },
        {
          "@value": "Caso de uso",
          "@language": "es"
        },
        {
          "@value": "Cas d'utilisation",
          "@language": "fr"
        },
        {
          "@value": "Сценарий использования",
          "@language": "ru"
        },
        {
          "@value": "用例",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "use case",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A use case is an example scenario of how the end-user will use the system.",
          "@language": "en"
        },
        {
          "@value": "حالة الاستخدام سيناريو توضيحي لكيفية استخدام المستخدم النهائي للنظام.",
          "@language": "ar"
        },
        {
          "@value": "Un caso de uso es un escenario de ejemplo de cómo el usuario final utilizará el sistema.",
          "@language": "es"
        },
        {
          "@value": "Un cas d'utilisation est un exemple de scénario décrivant la manière dont l'utilisateur final utilisera le système.",
          "@language": "fr"
        },
        {
          "@value": "Сценарий использования — это пример сценария того, как конечный пользователь будет использовать систему.",
          "@language": "ru"
        },
        {
          "@value": "用例是最终用户将如何使用系统的示例场景。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/use-case#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/use-case#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/use-case#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/use-case#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/use-case#label-zh"
        }
      ],
      "skos:scopeNote": "PHC handbook glossary wording, verbatim (who-iris/library/9789240093362-eng/sections/sec-002-glossary.md, p. 11). Wording alternative in SC handbook glossary (who-iris/library/9789240101197-eng/sections/page-009.md, p. 9): \"An example scenario of how the end user will use a system.\" Both are recorded as candidates; neither is chosen (smart-ra#133 S1).",
      "dcterms:source": "who-iris/library/9789240093362-eng/sections/sec-002-glossary.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/use-case#label-ar",
      "@type": "skosxl:Label",
      "skosxl:literalForm": {
