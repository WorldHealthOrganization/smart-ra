    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/product-master-data",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Product Master Data",
          "@language": "en"
        },
        {
          "@value": "البيانات الرئيسية للمنتج",
          "@language": "ar"
        },
        {
          "@value": "Datos maestros de productos",
          "@language": "es"
        },
        {
          "@value": "Données de référence des produits",
          "@language": "fr"
        },
        {
          "@value": "Мастер-данные продукции",
          "@language": "ru"
        },
        {
          "@value": "产品主数据",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "PMD",
          "@language": "en"
        },
        {
          "@value": "product master data",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Product master data consists of standardized information that accurately describes a health product’s characteristics. This data remains consistent across all instances of a product.",
          "@language": "en"
        },
        {
          "@value": "تتألف البيانات الرئيسية للمنتج من معلومات موحدة تصف خصائص المنتج الصحي بدقة. وتظل هذه البيانات متسقة في جميع حالات المنتج.",
          "@language": "ar"
        },
        {
          "@value": "Los datos maestros de productos consisten en información normalizada que describe con exactitud las características de un producto de salud. Estos datos se mantienen uniformes en todas las instancias de un producto.",
          "@language": "es"
        },
        {
          "@value": "Les données de référence des produits consistent en des informations normalisées qui décrivent avec exactitude les caractéristiques d'un produit de santé. Ces données restent identiques pour toutes les occurrences d'un produit.",
          "@language": "fr"
        },
        {
          "@value": "Мастер-данные продукции состоят из стандартизированной информации, точно описывающей характеристики продукции медицинского назначения. Эти данные остаются неизменными во всех экземплярах продукта.",
          "@language": "ru"
        },
        {
          "@value": "产品主数据由准确描述卫生产品特征的标准化信息组成。这些数据在产品的所有实例中保持一致。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/product-master-data#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/product-master-data#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/product-master-data#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/product-master-data#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/product-master-data#label-zh"
        }
