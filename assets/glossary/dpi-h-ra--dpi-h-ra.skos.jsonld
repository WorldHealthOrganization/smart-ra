        {
          "@value": "SNOMED-CT",
          "@language": "en"
        },
        {
          "@value": "Systematized Nomenclature of Medicine - Clinical Terms",
          "@language": "en"
        },
        {
          "@value": "Systematized Nomenclature of Medicine – Clinical Terms",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Systematized Nomenclature of Medicine Clinical Terms is a structured clinical terminology standard for use in electronic health records.",
          "@language": "en"
        },
        {
          "@value": "Systematized Nomenclature of Medicine Clinical Terms معيار مهيكل للمصطلحات السريرية مخصص للاستخدام في السجلات الصحية الإلكترونية.",
          "@language": "ar"
        },
        {
          "@value": "Systematized Nomenclature of Medicine Clinical Terms es un estándar de terminología clínica estructurada para su uso en las historias clínicas electrónicas.",
          "@language": "es"
        },
        {
          "@value": "La Systematized Nomenclature of Medicine Clinical Terms est une norme de terminologie clinique structurée destinée à être utilisée dans les dossiers de santé électroniques.",
          "@language": "fr"
        },
        {
          "@value": "Systematized Nomenclature of Medicine Clinical Terms — это структурированный стандарт клинической терминологии для использования в электронных записях о здоровье.",
          "@language": "ru"
        },
        {
          "@value": "Systematized Nomenclature of Medicine Clinical Terms是一种供电子健康档案使用的结构化临床术语标准。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
