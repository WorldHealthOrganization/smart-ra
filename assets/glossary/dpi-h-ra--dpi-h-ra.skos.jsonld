    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/terminology-service",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Terminology Service",
          "@language": "en"
        },
        {
          "@value": "خدمة المصطلحات",
          "@language": "ar"
        },
        {
          "@value": "Servicio de terminología",
          "@language": "es"
        },
        {
          "@value": "Service de terminologie",
          "@language": "fr"
        },
        {
          "@value": "Терминологический сервис",
          "@language": "ru"
        },
        {
          "@value": "术语服务",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "TS",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The Terminology Service is a governed, publicly accessible service that manages, publishes, and provides access to the standardised terminologies, code systems, value sets, and concept maps used across the digital health ecosystem.",
          "@language": "en"
        },
        {
          "@value": "خدمة المصطلحات خدمة خاضعة للحوكمة ومتاحة للعموم، تدير المصطلحات الموحدة ونظم الترميز ومجموعات القيم وخرائط المفاهيم المستخدمة في منظومة الصحة الرقمية، وتنشرها وتتيح الوصول إليها.",
          "@language": "ar"
        },
        {
          "@value": "El Servicio de terminología es un servicio gobernado y de acceso público que gestiona, publica y proporciona acceso a las terminologías normalizadas, los sistemas de códigos, los conjuntos de valores y los mapas de conceptos utilizados en todo el ecosistema de salud digital.",
          "@language": "es"
        },
        {
          "@value": "Le service de terminologie est un service gouverné et accessible au public qui gère et publie les terminologies normalisées, systèmes de codes, ensembles de valeurs et correspondances de concepts utilisés dans l'ensemble de l'écosystème de santé numérique, et en donne accès.",
          "@language": "fr"
        },
        {
          "@value": "Терминологический сервис — это управляемый общедоступный сервис, который управляет стандартизированными терминологиями, системами кодирования, наборами значений и картами соответствия понятий, используемыми во всей экосистеме цифрового здравоохранения, публикует их и обеспечивает доступ к ним.",
          "@language": "ru"
        },
        {
          "@value": "术语服务是一项受治理、可公开访问的服务，负责管理、发布并提供对整个数字卫生生态系统中所使用的标准化术语、代码系统、值集和概念映射的访问。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/terminology-service#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/terminology-service#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/terminology-service#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/terminology-service#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/terminology-service#label-zh"
        }
      ],
      "skos:notation": "TS",
      "skos:scopeNote": "Verbatim lead sentence from Appendix C (Terminology Service, 1 What It Is). Abbreviated TS throughout the RA draft and downstream Digital Transformation Handbooks. A candidate until the RA editors adopt it through the public review.",
      "dcterms:source": "folio/dpi-h-ra/appendix/p-c-metadata-registries-and-foundati-terminology-service-6c5267.md",
      "skos:note": "candidate"
    },
