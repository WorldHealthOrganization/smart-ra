    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/user-persona",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "User Persona",
          "@language": "en"
        },
        {
          "@value": "شخصية المستخدم",
          "@language": "ar"
        },
        {
          "@value": "Persona de usuario",
          "@language": "es"
        },
        {
          "@value": "Persona utilisateur",
          "@language": "fr"
        },
        {
          "@value": "Персона пользователя",
          "@language": "ru"
        },
        {
          "@value": "用户画像",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "Persona",
          "@language": "en"
        },
        {
          "@value": "persona",
          "@language": "en"
        },
        {
          "@value": "user persona",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A generic or archetypical profile of an end-user that is representative of a single type of end-user.",
          "@language": "en"
        },
        {
          "@value": "ملف تعريفي عام أو نموذجي للمستخدم النهائي يمثل نوعًا واحدًا من المستخدمين النهائيين.",
          "@language": "ar"
        },
        {
          "@value": "Perfil genérico o arquetípico de un usuario final que es representativo de un único tipo de usuario final.",
          "@language": "es"
        },
        {
          "@value": "Profil générique ou archétypal d'un utilisateur final, représentatif d'un type unique d'utilisateur final.",
          "@language": "fr"
        },
        {
          "@value": "Обобщенный или архетипический профиль конечного пользователя, представляющий отдельный тип конечного пользователя.",
          "@language": "ru"
        },
        {
          "@value": "代表某一类最终用户的通用或原型化最终用户画像。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/user-persona#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/user-persona#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/user-persona#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/user-persona#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/user-persona#label-zh"
        }
      ],
      "skos:scopeNote": "PHC handbook glossary wording under 'User persona', verbatim (who-iris/library/9789240093362-eng/sections/sec-002-glossary.md, p. 11). Internal and cross-DTH alternatives (smart-ra#133 S1): (1) PHC handbook §3.2.1 body (who-iris/library/9789240093362-eng/sections/sec-013-32-get-to-know-the-users.md, pp. 33-35): \"A user persona is a generic depiction of a relevant stakeholder, or end-user of the system who would be interacting with the PCPOSS.\" (2) SFP handbook glossary under 'Persona' (who-iris/library/9789240120747-eng/sections/page-010.md, p. 10): \"A generic aggregate description of a person involved in or benefiting from a health programme.\" All three are recorded as candidates; none is chosen.",
      "dcterms:source": "who-iris/library/9789240093362-eng/sections/sec-002-glossary.md",
      "skos:note": "candidate"
    },
