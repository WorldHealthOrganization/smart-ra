    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/application-service",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Application Service",
          "@language": "en"
        },
        {
          "@value": "الخدمة التطبيقية",
          "@language": "ar"
        },
        {
          "@value": "Servicio de aplicación",
          "@language": "es"
        },
        {
          "@value": "Service applicatif",
          "@language": "fr"
        },
        {
          "@value": "Сервис приложения",
          "@language": "ru"
        },
        {
          "@value": "应用服务",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "An explicitly defined unit of application behaviour. Anch application service exposes the functionality of an application component to its environment.",
          "@language": "en"
        },
        {
          "@value": "وحدة محددة صراحةً من سلوك التطبيق. وتتيح كل خدمة تطبيقية وظائف المكوّن التطبيقي لبيئته.",
          "@language": "ar"
        },
        {
          "@value": "Unidad de comportamiento de la aplicación definida de forma explícita. Anch servicio de aplicación expone la funcionalidad de un componente de aplicación a su entorno.",
          "@language": "es"
        },
        {
          "@value": "Unité explicitement définie de comportement applicatif. Anch service applicatif expose les fonctionnalités d'un composant applicatif à son environnement.",
          "@language": "fr"
        },
        {
          "@value": "Явно определенная единица поведения приложения. Каждый сервис приложения предоставляет функциональные возможности компонента приложения его окружению.",
          "@language": "ru"
        },
        {
          "@value": "明确定义的应用行为单元。每个应用服务将应用组件的功能向其环境公开。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/application-service#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/application-service#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/application-service#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/application-service#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/application-service#label-zh"
        }
      ],
      "skos:scopeNote": "The RA draft's own glossary wording, verbatim (folio/dpi-h-ra/glossary/t-glossary-lead-a31853.md). Wording alternative in RA Table 3.1 (library/who-dpi-h-reference-architecture-draft-v1/sections/sec-026-31-the-architecture-description-approach.md): \"An externally visible unit of functionality provided by one or more components, exposed through well-defined interfaces.\" Both are recorded as candidates; neither is chosen (smart-ra#133 S1).",
      "skos:example": [
        {
          "@value": "Resolving and matching a person’s identity across systems.",
          "@language": "en"
        }
      ],
      "dcterms:source": "folio/dpi-h-ra/glossary/t-glossary-lead-a31853.md",
      "skos:note": "candidate"
