      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/monitoring",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Monitoring",
          "@language": "en"
        },
        {
          "@value": "الرصد",
          "@language": "ar"
        },
        {
          "@value": "Seguimiento",
          "@language": "es"
        },
        {
          "@value": "Suivi",
          "@language": "fr"
        },
        {
          "@value": "Мониторинг",
          "@language": "ru"
        },
        {
          "@value": "监测",
          "@language": "zh"
        }
      ],
      "skos:altLabel": [
        {
          "@value": "monitoring",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The continuous process of collecting and analysing data to compare how well an intervention is being implemented against expected results (8).",
          "@language": "en"
        },
        {
          "@value": "العملية المستمرة لجمع البيانات وتحليلها لمقارنة مدى جودة تنفيذ التدخل بالنتائج المتوقعة (8).",
          "@language": "ar"
        },
        {
          "@value": "Proceso continuo de recopilación y análisis de datos para comparar en qué medida se está implementando una intervención con respecto a los resultados esperados (8).",
          "@language": "es"
        },
        {
          "@value": "Processus continu de collecte et d'analyse de données visant à comparer la qualité de la mise en œuvre d'une intervention aux résultats attendus (8).",
          "@language": "fr"
        },
        {
          "@value": "Непрерывный процесс сбора и анализа данных для сопоставления того, насколько успешно осуществляется вмешательство, с ожидаемыми результатами (8).",
          "@language": "ru"
        },
        {
          "@value": "收集和分析数据的持续过程，以将干预措施的实施情况与预期结果进行比较 (8)。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/monitoring#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/monitoring#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/monitoring#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/monitoring#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/monitoring#label-zh"
        }
      ],
      "skos:scopeNote": "SFP handbook glossary wording, verbatim (who-iris/library/9789240120747-eng/sections/sec-002-glossary.md, page-010.md, p. 10, citing Monitoring and evaluating digital health interventions, WHO 2016). Wording alternative in DIIG Annex 1.1 Glossary (who-iris/library/9789240010567-eng/sections/page-141.md, p. 129, citing WHO evaluation practice handbook, 2013): \"The process of collecting and analysing routinely collected data to compare how well an intervention is being implemented against expected results and measure changes in performance over time.\" Both definitions are recorded as candidates; neither is chosen (smart-ra#133 S1, dth-sfp#1 §2.1 Cluster B1).",
      "skos:related": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/dpi-h-ra/evaluation"
        }
      ],
      "dcterms:source": "who-iris/library/9789240120747-eng/sections/sec-002-glossary.md",
      "skos:note": "candidate"
    },
