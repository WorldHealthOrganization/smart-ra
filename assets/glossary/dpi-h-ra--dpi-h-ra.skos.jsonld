      ],
      "skos:definition": [
        {
          "@value": "FHIR is a standard for healthcare data exchange, published by HL7®",
          "@language": "en"
        },
        {
          "@value": "FHIR معيار لتبادل بيانات الرعاية الصحية، تنشره HL7®",
          "@language": "ar"
        },
        {
          "@value": "FHIR es un estándar para el intercambio de datos de atención de salud, publicado por HL7®",
          "@language": "es"
        },
        {
          "@value": "FHIR est une norme d'échange de données de santé, publiée par HL7®",
          "@language": "fr"
        },
        {
          "@value": "FHIR — это стандарт обмена медицинскими данными, публикуемый HL7®",
          "@language": "ru"
        },
        {
          "@value": "FHIR是由HL7®发布的卫生保健数据交换标准",
          "@language": "zh"
        }
      ],
