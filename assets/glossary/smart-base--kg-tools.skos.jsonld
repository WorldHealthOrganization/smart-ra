      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools/l1-extraction-pages",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "L1 extraction viewer: a hub and a page per instance with `l1-extraction` directories"
        }
      ],
      "skos:definition": [
        {
          "@value": "For every visualiser an instance declares with `renderedBy: l1-extraction-pages`, write the hub at `<locale>/<harness>/<id>/` and, with `subgraphs: \"instance\"`, one page per instance that declares an `l1-extraction` directory. Each page shows, from what the files declare: the L1 statements (graph nodes with a `statement`, and an authored L1 source's `recommendations`); the candidate work list's counts, coverage and decisions; each graph document's nodes by type and edges by predicate (L2 scenario candidates included); counts of curation, mapping, vocabulary, exclusions and run context; and a link from every file to its published copy (cat-harness's `library:viz`), when the site has it, and to its source at the pinned commit. A declared directory not on disk is reported UNKNOWN, never zero."
        }
      ],
      "skos:notation": "l1-extraction-pages",
      "dcterms:source": "smart-base/tools/l1-extraction-pages/l1-extraction-pages.ts#l1-extraction-pages",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools/l1-recommendation-candidates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "L1 guideline → recommendation candidates (L1 3.0)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Find every normative sentence of an ingested `library/` entry (folio-assistant-core's `l1-coverage` markers), flag uncertain readings, and propose the publication's identity. Given an agent's `l1-recommendation-curation/v1`, refuse a non-verbatim statement or an unknown location, and write the recommendations and remarks as an L1 3.0 graph (checked with `L1/schemas/validate.ts`) with coverage and proposed, unsigned exclusions."
        }
      ],
      "skos:notation": "l1-recommendation-candidates",
      "dcterms:source": "smart-base/L1/tools/l1-recommendation-candidates/l1-recommendation-candidates.ts#l1-recommendation-candidates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools/l1-statement-lists",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "L1 extraction → statement lists"
        }
      ],
      "skos:definition": [
        {
          "@value": "The smart-base collector for core's `publish-extracted-statements` step: an `l1-extraction` directory's authored L1 sources (`recommendations:` rows) and scenario-candidate graphs (`user-scenario` nodes whose `evidence.location` names a row), written as `folio-extracted-statements/v1` lists, each statement with the library entry its L1 source names and the page it was read from. Core's `statements:pages` then renders them with links to the entry and section."
        }
      ],
      "skos:notation": "l1-statement-lists",
      "dcterms:source": "smart-base/L1/tools/l1-statement-lists/l1-statement-lists.ts#l1-statement-lists",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools/l1-transcription-verbatim",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Authored L1 → verbatim against transcriptions and image narratives"
        }
      ],
      "skos:definition": [
        {
          "@value": "Check authored L1 (`*.l1.yaml`, the measles pattern) for a source with no usable text layer: each statement must be verbatim in the image narrative (`images.json`) or the `transcription` block it names; every transcription word (digits aside) must be corroborated by the entry's text layer unless listed under `inspectionOnly`; keys must be unique."
        }
      ],
      "skos:notation": "l1-transcription-verbatim",
      "dcterms:source": "smart-base/L1/tools/l1-transcription-verbatim/l1-transcription-verbatim.ts#l1-transcription-verbatim",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools/smart-fhir-cache-seed",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Seed the FHIR package cache, with WHO's published site as a source"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run fhir-harness's `fhir-cache-seed-npm` with smart-base's publisher-site rules (`SMART_PUBLISHER_SITE_REPOS`), so `smart.who.int.*` packages can also be read from WHO's published-site repository, each fetch verified against the tarball's own package.json. All other sources and checks are the seeder's."
        }
      ],
      "skos:notation": "smart-fhir-cache-seed",
