      },
      "skos:prefLabel": [
        {
          "@value": "classify-and-code-content"
        }
      ],
      "skos:definition": [
        {
          "@value": "Classify and code L1 narrative content (recommendations, implementation practices, remarks, and proposed coverage exclusions) and L2 DAK slots (personas, business processes, guideline domains, conditions, interventions, medicines, and GRADE ratings) using the `terminology-coding` methodology and the `terminology-lookup` Tool. Covers the authoring-agent's four-rung reuse-first lookup, the `l1-extraction-reviewer` lane that reads and signs proposed L1 coverage exclusions against the printed page, and the `terminologist` / ontologist lane that adjudicates candidate codings and local glossary candidates."
        }
      ],
      "skos:notation": "classify-and-code-content",
      "dcterms:source": "smart-base/L1/skills/smart-l1/classify-and-code-content.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/dak-l1-library",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "dak-l1-library"
        }
      ],
      "skos:definition": [
        {
          "@value": "Build a DAK's library from the L1 sources its Component 1 cites, and the L1 knowledge graph that records them. Read when starting or extending a DAK library, when a DAK's guidance changes, and before writing any L1 graph for a DAK. Covers fetching a cited WHO IRIS item, ingesting it, deciding whether it is L1 (declared > context > inferred), extracting the Component 1 graph, the L1 graph of each L1 source as a specialisation of its library entry, and the layering rule: the library is upstream of L1."
        }
      ],
      "skos:notation": "dak-l1-library",
      "dcterms:source": "smart-base/L1/skills/smart-l1/dak-l1-library.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/grade",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "grade"
        }
      ],
      "skos:definition": [
        {
          "@value": "GRADE — the grading system a WHO guideline folio declares for certainty of evidence, and the Evidence-to-Decision judgement a recommendation rests on. Read when a folio's `Task_AppraiseGrade` runs under GRADE, before recording a certainty, an EtD judgement or a recommendation's direction and strength."
        }
      ],
      "skos:notation": "grade",
      "dcterms:source": "smart-base/L1/skills/smart-l1/grade.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/guideline-use-case",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "guideline-use-case"
        }
      ],
      "skos:definition": [
        {
          "@value": "Stage 0 of smart-guideline-end-to-end: turn a request for a SMART Guideline into a use case — population, setting, jurisdiction and interventions in scope, new or an adaptation — in the requester's own words. The agent asks numbered questions for what the request did not say, and never invents the answer. Read when a guideline request arrives, before any L1 source is looked for."
        }
      ],
      "skos:notation": "guideline-use-case",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/guideline-use-case.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/indicator-extraction",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "indicator-extraction"
        }
      ],
      "skos:definition": [
        {
          "@value": "Extract the indicators an L1 source prints (indicator reference or metadata sheets: name, numerator, denominator, disaggregation, definition, data sources) as L1 `indicator` nodes with every printed field, then draft one L2 program indicator per indicator, derived from its L1 node. Read before adding a WHO handbook's or guideline's indicators to a DAK or a DTH, and whenever an L2 indicator has to trace to its source. Part of L1 → L2 extraction for every DAK and DTH, beside recommendation-extraction."
        }
      ],
      "skos:notation": "indicator-extraction",
      "dcterms:source": "smart-base/L1/skills/smart-l1/indicator-extraction.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/recommendation-candidates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "recommendation-candidates"
        }
      ],
      "skos:definition": [
        {
          "@value": "Turn one ingested L1 source into L1 3.0 recommendation nodes: list every normative sentence as a candidate, let the agent decide each in a curation file, then refuse a non-verbatim statement or unknown location and write the graph, coverage and proposed exclusions. Step 1 of recommendation-extraction, run once per included source; the `l1-recommendation-candidates` Tool satisfies it."
        }
      ],
      "skos:notation": "recommendation-candidates",
      "dcterms:source": "smart-base/L1/skills/smart-l1/recommendation-candidates.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/recommendation-extraction",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "recommendation-extraction"
        }
      ],
      "skos:definition": [
        {
          "@value": "Extract the recommendations of an L1 source as L1 3.0 recommendation and remark nodes, then describe each one's scenario: the persona (role) who acts on it, the business process they act in, and the user story, as smart-kg L2 user-scenario candidates that reuse the target guide's own vocabulary. Read before extracting recommendations from a WHO guideline or position paper with no printed \"Recommendation N\" labels, before linking a recommendation to a DAK persona or process, and whenever a recommendation has to say who does it and where. Covers the hybrid extraction (mechanical candidates, agent structuring, verbatim and 100 % coverage gates), the reuse-first precedence for personas and processes, the WARNING format, and sign-off."
        }
      ],
      "skos:notation": "recommendation-extraction",
      "dcterms:source": "smart-base/L1/skills/smart-l1/recommendation-extraction.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/recommendation-scenarios",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "recommendation-scenarios"
        }
      ],
      "skos:definition": [
        {
          "@value": "Join each L1 recommendation to who acts on it and during which business process: one smart-kg L2 user-scenario candidate per recommendation, from the agent's mapping, reusing the target guide's personas and processes first, then smart-base's generic personas, and never inventing a process. Step 2 of recommendation-extraction; the `l1-recommendation-scenarios` Tool satisfies it."
        }
      ],
      "skos:notation": "recommendation-scenarios",
      "dcterms:source": "smart-base/L1/skills/smart-l1/recommendation-scenarios.md",
      "skos:note": "candidate"
    },
