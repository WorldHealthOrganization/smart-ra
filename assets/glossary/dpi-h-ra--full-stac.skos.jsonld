    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/full-stac/digital-health-governance",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/full-stac"
      },
      "skos:prefLabel": [
        {
          "@value": "Digital Health Governance",
          "@language": "en"
        },
        {
          "@value": "حوكمة الصحة الرقمية",
          "@language": "ar"
        },
        {
          "@value": "Gobernanza de la salud digital",
          "@language": "es"
        },
        {
          "@value": "Gouvernance de la santé numérique",
          "@language": "fr"
        },
        {
          "@value": "Управление цифровым здравоохранением",
          "@language": "ru"
        },
        {
          "@value": "数字卫生治理",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "Digital health governance defines who, what and how to govern to achieve health service impact.",
          "@language": "en"
        },
        {
          "@value": "تحدد حوكمة الصحة الرقمية مَن يتولى الحوكمة، وما الذي يخضع لها، وكيف تُمارَس، من أجل تحقيق أثر على الخدمات الصحية.",
          "@language": "ar"
        },
        {
          "@value": "La gobernanza de la salud digital define a quién, qué y cómo gobernar para lograr un impacto en los servicios de salud.",
          "@language": "es"
        },
        {
          "@value": "La gouvernance de la santé numérique définit qui, quoi et comment gouverner pour obtenir un impact sur les services de santé.",
          "@language": "fr"
        },
        {
          "@value": "Управление цифровым здравоохранением определяет, кто управляет, чем и каким образом, для достижения воздействия на услуги здравоохранения.",
          "@language": "ru"
        },
        {
          "@value": "数字卫生治理界定由谁治理、治理什么以及如何治理，以实现卫生服务影响。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/full-stac/digital-health-governance#label-ar"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/full-stac/digital-health-governance#label-es"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/full-stac/digital-health-governance#label-fr"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/full-stac/digital-health-governance#label-ru"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/full-stac/digital-health-governance#label-zh"
        }
      ],
      "skos:scopeNote": "The paper cites Marcelo et al. 2018 (ADB) for this sentence, so the definition is that source's, as quoted here.",
      "dcterms:source": "library/mehl-2023-full-stac-oqad018/sections/sec-000-a-full-stac-remedy-for-global-digital-health-tra.md",
      "skos:note": "candidate"
    },
    {
