    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/full-stac/open-technologies",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/full-stac"
      },
      "skos:prefLabel": [
        {
          "@value": "Open Technologies",
          "@language": "en"
        },
        {
          "@value": "التكنولوجيات المفتوحة",
          "@language": "ar"
        },
        {
          "@value": "Tecnologías abiertas",
          "@language": "es"
        },
        {
          "@value": "Technologies ouvertes",
          "@language": "fr"
        },
        {
          "@value": "Открытые технологии",
          "@language": "ru"
        },
        {
          "@value": "开放技术",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "Modular, standards-based, and accessible software tools that help developers and users to collect, store, transmit, or analyze data represented in open standards. Open technologies are developed and maintained through transparent, community-based processes, and are licensed under an open-source software license.",
          "@language": "en"
        },
        {
          "@value": "أدوات برمجية نمطية وقائمة على المعايير ومتاحة، تساعد المطورين والمستخدمين على جمع البيانات الممثَّلة بمعايير مفتوحة أو تخزينها أو إرسالها أو تحليلها. وتُطوَّر التكنولوجيات المفتوحة وتُصان من خلال عمليات شفافة قائمة على المجتمع، وتُرخَّص بموجب رخصة برمجيات مفتوحة المصدر.",
          "@language": "ar"
        },
        {
          "@value": "Herramientas de software modulares, basadas en estándares y accesibles que ayudan a los desarrolladores y usuarios a recopilar, almacenar, transmitir o analizar datos representados en estándares abiertos. Las tecnologías abiertas se desarrollan y mantienen mediante procesos transparentes y comunitarios, y se distribuyen con una licencia de software de código abierto.",
          "@language": "es"
        },
        {
          "@value": "Outils logiciels modulaires, fondés sur des normes et accessibles, qui aident les développeurs et les utilisateurs à collecter, stocker, transmettre ou analyser des données représentées selon des normes ouvertes. Les technologies ouvertes sont élaborées et tenues à jour au moyen de processus transparents et communautaires, et sont diffusées sous une licence de logiciel à code source ouvert.",
          "@language": "fr"
        },
        {
          "@value": "Модульные, основанные на стандартах и доступные программные инструменты, которые помогают разработчикам и пользователям собирать, хранить, передавать или анализировать данные, представленные в открытых стандартах. Открытые технологии разрабатываются и поддерживаются в рамках прозрачных процессов на базе сообществ и распространяются по лицензии на программное обеспечение с открытым исходным кодом.",
          "@language": "ru"
        },
        {
          "@value": "模块化、基于标准且易于获取的软件工具，帮助开发者和用户收集、存储、传输或分析以开放标准表示的数据。开放技术通过透明的、基于社区的过程开发和维护，并采用开源软件许可证授权。",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/full-stac/open-technologies#label-ar"
        },
