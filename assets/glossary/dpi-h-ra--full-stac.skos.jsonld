        {
          "@value": "以人为本的卫生",
          "@language": "zh"
        }
      ],
      "skosxl:prefLabel": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns/glossary/full-stac/person-focused-health#label-ar"
        },
